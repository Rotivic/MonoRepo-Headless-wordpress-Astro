---
import AuthLayout from '../components/AuthLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Registro | TCG Platform">
  <SiteHeader active="registro" />
  <AuthLayout
    eyebrow="Alta de usuario"
    title="Crea una cuenta real en WordPress."
    summary="El registro web usa el mismo endpoint que consumira Flutter. La cuenta queda disponible para futuras areas como wishlist, compras, ventas e inventario."
  >
    <form class="auth-form" id="register-form">
      <div class="form-head">
        <h2>Crear cuenta</h2>
        <p>La contrasena debe tener al menos 12 caracteres.</p>
      </div>

      <div class="name-grid">
        <div class="field">
          <label for="first_name">Nombre</label>
          <input id="first_name" name="first_name" type="text" autocomplete="given-name" required />
        </div>

        <div class="field">
          <label for="last_name">Apellidos</label>
          <input id="last_name" name="last_name" type="text" autocomplete="family-name" required />
        </div>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="password">Contrasena</label>
        <input id="password" name="password" type="password" minlength="12" autocomplete="new-password" required />
      </div>

      <div class="field">
        <label for="password_confirmation">Repetir contrasena</label>
        <input id="password_confirmation" name="password_confirmation" type="password" minlength="12" autocomplete="new-password" required />
      </div>

      <p class="status-message" id="register-status" aria-live="polite"></p>

      <button class="button button-primary" type="submit">Crear cuenta</button>
      <a class="button button-secondary" href="/login">Ya tengo cuenta</a>
    </form>
  </AuthLayout>

  <script define:vars={{ registerUrl: tcgApi.register }}>
    const form = document.querySelector('#register-form');
    const status = document.querySelector('#register-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.dataset.state = '';
      status.textContent = 'Creando cuenta...';

      const formData = new FormData(form);
      const payload = {
        first_name: formData.get('first_name'),
        last_name: formData.get('last_name'),
        email: formData.get('email'),
        password: formData.get('password'),
        password_confirmation: formData.get('password_confirmation'),
        device_name: 'astro-web',
      };

      if (payload.password !== payload.password_confirmation) {
        status.dataset.state = 'error';
        status.textContent = 'Las contrasenas no coinciden.';
        return;
      }

      try {
        const response = await fetch(registerUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload),
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'No se pudo crear la cuenta.');
        }

        status.dataset.state = 'success';
        status.textContent = 'Cuenta creada. Redirigiendo...';
        try {
          window.localStorage.setItem('tcg.authenticated', '1');
          window.localStorage.setItem('tcg.user.summary', JSON.stringify({
            avatar_url: data.data?.avatar_url || '',
            initials: ([data.data?.first_name, data.data?.last_name].filter(Boolean).join(' ') || data.data?.email || 'U').slice(0, 1).toUpperCase(),
          }));
        } catch {
          // The HttpOnly cookie is the source of truth.
        }
        window.location.assign('/perfil');
      } catch (error) {
        status.dataset.state = 'error';
        status.textContent = error instanceof Error ? error.message : 'No se pudo crear la cuenta.';
      }
    });
  </script>
</BaseLayout>

<style>
  .auth-form {
    display: grid;
    gap: 18px;
  }

  .form-head h2 {
    margin: 0;
    font-size: 1.55rem;
    font-weight: 600;
  }

  .form-head p {
    margin: 8px 0 0;
    color: var(--color-body);
    line-height: 1.5;
  }

  .name-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 520px) {
    .name-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
