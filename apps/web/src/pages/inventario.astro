---
import BackButton from '../components/BackButton.astro';
import ModuleDisabled from '../components/ModuleDisabled.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pagination from '../components/Pagination.astro';
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Inventario | ${siteConfig.name}`}>
  <SiteHeader active="tienda" />

  {
    siteConfig.features.shop ? (
      <main class="inventory-view">
        <section class="page-shell inventory-shell" id="inventory-loading">
          <div>
            <BackButton fallback="/admin" />
            <p class="eyebrow">Catalogo</p>
            <h1>Inventario</h1>
            <p class="lede">Validando permisos y cargando productos...</p>
          </div>
          <section class="inventory-panel">
            <div class="inventory-skeleton">
              <article><span></span><span></span><span></span></article>
              <article><span></span><span></span><span></span></article>
              <article><span></span><span></span><span></span></article>
            </div>
          </section>
        </section>
        <section class="page-shell inventory-shell" id="backoffice-page" hidden>
          <div>
            <BackButton fallback="/admin" />
            <p class="eyebrow">Catalogo</p>
            <h1>Inventario</h1>
            <p class="lede">Vista de lectura para revisar productos desde el frontend. La edicion de stock, precios y fichas debe seguir en WooCommerce.</p>
          </div>

          <section class="inventory-panel">
            <p class="notice" id="inventory-status" hidden></p>
            <div class="table" id="inventory-table"></div>
            <Pagination id="inventory-pagination" label="Paginacion de inventario" />
          </section>
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Inventario desactivado"
        summary="El inventario forma parte del modulo tienda. Puedes ocultarlo con PUBLIC_ENABLE_SHOP=false."
      />
    )
  }

  <script>
    import { setupLocalPagination } from '../lib/pagination';
    import { formatStorePrice, shopApi } from '../lib/shop';
    import { tcgApi } from '../lib/tcg-api';

    const meUrl = tcgApi.me;
    const page = document.querySelector('#backoffice-page');
    const loading = document.querySelector('#inventory-loading');
    const status = document.querySelector('#inventory-status');
    const table = document.querySelector('#inventory-table');
    const pagination = document.querySelector('#inventory-pagination');

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const setStatus = (message, state = '') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = !message;
    };

    const renderProducts = (products) => {
      if (!table) return;

      table.innerHTML = products.map((product) => {
        const image = product.images?.[0];
        const name = escapeHtml(product.name);
        const slug = escapeHtml(product.slug);
        const price = escapeHtml(formatStorePrice(product.prices));
        const stockCount = Number(product.low_stock_remaining ?? product.stock_quantity);
        const hasStockCount = Number.isFinite(stockCount) && stockCount >= 0;
        const stockLabel = product.is_in_stock
          ? hasStockCount ? `Quedan ${stockCount}` : 'Disponible'
          : 'Sin stock';
        const stockState = product.is_in_stock ? (hasStockCount && stockCount <= 3 ? 'low' : 'available') : 'empty';

        return `
          <article class="row inventory-page-item">
            <div class="product-cell">
              <div class="product-thumb">
                ${image?.src ? `<img src="${escapeHtml(image.src)}" alt="" loading="lazy">` : `<span aria-hidden="true">${name.slice(0, 1).toUpperCase()}</span>`}
              </div>
              <div class="product-meta">
                <strong>${name}</strong>
                <span>${slug}</span>
              </div>
            </div>
            <span class="price-pill">${price}</span>
            <span class="stock-pill" data-stock="${stockState}">${stockLabel}</span>
          </article>
        `;
      }).join('');

      table.hidden = products.length === 0;
      if (pagination) pagination.hidden = products.length <= 10;
      setStatus(products.length === 0 ? 'No hay productos para mostrar.' : '');

      setupLocalPagination({
        root: document,
        itemSelector: '.inventory-page-item',
        pagination,
        perPage: 10,
      }).refresh();
    };

    const loadInventory = async () => {
      const authResponse = await fetch(meUrl, { credentials: 'include' });
      if (!authResponse.ok) throw new Error('Debes iniciar sesion.');

      const payload = await authResponse.json();
      if (!payload.data?.can_access_backoffice) throw new Error('Sin permisos.');

      const productsResponse = await fetch(`${shopApi.products}?per_page=50`);
      if (!productsResponse.ok) throw new Error(`WooCommerce respondio con ${productsResponse.status}`);

      renderProducts(await productsResponse.json());
      if (loading) loading.hidden = true;
      if (page) page.hidden = false;
    };

    loadInventory()
      .catch((error) => {
        if (loading) loading.hidden = true;
        if (page) page.hidden = false;
        if (table) table.hidden = true;
        if (pagination) pagination.hidden = true;
        if (error instanceof Error && (error.message === 'Debes iniciar sesion.' || error.message === 'Sin permisos.')) {
          window.location.assign('/login');
          return;
        }
        setStatus(error instanceof Error ? error.message : 'No se pudo cargar el inventario.', 'error');
      });
  </script>
</BaseLayout>

<style>
  .inventory-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .inventory-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.15fr);
    gap: 40px;
    align-items: start;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  .notice,
  .row span {
    color: var(--color-body);
    line-height: 1.7;
  }

  .inventory-panel {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .notice[data-state="error"] {
    color: var(--color-danger);
  }

  #inventory-loading[hidden],
  #backoffice-page[hidden] {
    display: none;
  }

  .inventory-skeleton {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-item);
  }

  .inventory-skeleton article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px 112px;
    gap: 14px;
    align-items: center;
    background: var(--color-surface-soft);
    padding: 14px;
  }

  .inventory-skeleton span {
    height: 13px;
    border-radius: 999px;
    background: var(--color-surface-strong);
  }

  .inventory-skeleton article span:first-child {
    width: 100%;
    height: 54px;
    border-radius: var(--radius-item);
    background: linear-gradient(90deg, var(--color-surface-strong), #f9fafb, var(--color-surface-strong));
    background-size: 200% 100%;
    animation: inventory-skeleton-pulse 1.2s ease-in-out infinite;
  }

  @keyframes inventory-skeleton-pulse {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .table {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-hairline);
  }

  :global(.row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 14px;
    align-items: center;
    background: var(--color-canvas);
    padding: 12px 14px;
  }

  :global(.product-cell) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-width: 0;
  }

  :global(.product-thumb) {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-item);
    background: var(--color-surface-strong);
    color: var(--color-primary);
    font-weight: 800;
  }

  :global(.product-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.product-meta) {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  :global(.product-meta strong),
  :global(.product-meta span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.price-pill),
  :global(.stock-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    border-radius: var(--radius-pill);
    padding: 0 12px;
    font-size: 0.86rem;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.price-pill) {
    border: 1px solid #b8d7d1;
    background: #eef8f5;
    color: #126455 !important;
  }

  :global(.stock-pill[data-stock="available"]) {
    border: 1px solid #b9dfc3;
    background: #effaf1;
    color: #217a35 !important;
  }

  :global(.stock-pill[data-stock="low"]) {
    border: 1px solid #f3d29a;
    background: #fff7e8;
    color: #9a5a00 !important;
  }

  :global(.stock-pill[data-stock="empty"]) {
    border: 1px solid #f0b8b8;
    background: #fff0f0;
    color: var(--color-danger) !important;
  }

  @media (max-width: 860px) {
    .inventory-shell,
    :global(.row) {
      grid-template-columns: 1fr;
    }

    :global(.price-pill),
    :global(.stock-pill) {
      justify-content: flex-start;
    }
  }
</style>
