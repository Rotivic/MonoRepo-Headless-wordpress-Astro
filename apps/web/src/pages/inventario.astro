---
import BackButton from '../components/BackButton.astro';
import ModuleDisabled from '../components/ModuleDisabled.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Inventario | ${siteConfig.name}`}>
  <SiteHeader active="tienda" />

  {
    siteConfig.features.shop ? (
      <main class="inventory-view">
        <section class="page-shell inventory-shell" id="inventory-loading">
          <div>
            <BackButton fallback="/admin" />
            <p class="eyebrow">Catalogo</p>
            <h1>Inventario</h1>
            <p class="lede">Validando permisos y cargando productos...</p>
          </div>
          <section class="inventory-panel">
            <div class="inventory-skeleton">
              <article><span></span><span></span><span></span></article>
              <article><span></span><span></span><span></span></article>
              <article><span></span><span></span><span></span></article>
            </div>
          </section>
        </section>
        <section class="page-shell inventory-shell" id="backoffice-page" hidden>
          <div>
            <BackButton fallback="/admin" />
            <p class="eyebrow">Catalogo</p>
            <h1>Inventario</h1>
            <p class="lede">Vista de lectura para revisar productos desde el frontend. La edicion de stock, precios y fichas debe seguir en WooCommerce.</p>
          </div>

          <section class="inventory-panel">
            <p class="notice" id="inventory-status" hidden></p>
            <form class="inventory-filters" id="inventory-filters">
              <input id="inventory-search" type="search" placeholder="Buscar por nombre o SKU" autocomplete="off" />
              <select id="inventory-stock">
                <option value="">Todo el stock</option>
                <option value="instock">En stock</option>
                <option value="outofstock">Sin stock</option>
                <option value="onbackorder">Reserva/backorder</option>
              </select>
              <select id="inventory-type">
                <option value="">Todos los tipos</option>
                <option value="simple">Simple</option>
                <option value="variable">Variable</option>
                <option value="variation">Variacion</option>
              </select>
              <button class="button button-secondary" id="inventory-clear" type="button">Limpiar</button>
            </form>
            <div class="alert-grid" id="inventory-alerts"></div>
            <div class="table" id="inventory-table"></div>
            <nav class="inventory-pagination" id="inventory-pagination" aria-label="Paginacion de inventario">
              <button class="button button-secondary" data-prev type="button">Anterior</button>
              <span data-status>Pagina 1 de 1</span>
              <button class="button button-secondary" data-next type="button">Siguiente</button>
            </nav>
          </section>
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Inventario desactivado"
        summary="El inventario forma parte del modulo tienda. Puedes ocultarlo con PUBLIC_ENABLE_SHOP=false."
      />
    )
  }

  <script>
    import { cachedJson } from '../lib/fetch-cache';
    import { tcgApi } from '../lib/tcg-api';

    const meUrl = tcgApi.me;
    const inventoryUrl = tcgApi.adminInventory;
    const page = document.querySelector('#backoffice-page');
    const loading = document.querySelector('#inventory-loading');
    const status = document.querySelector('#inventory-status');
    const table = document.querySelector('#inventory-table');
    const pagination = document.querySelector('#inventory-pagination');
    const filters = document.querySelector('#inventory-filters');
    const searchInput = document.querySelector('#inventory-search');
    const stockSelect = document.querySelector('#inventory-stock');
    const typeSelect = document.querySelector('#inventory-type');
    const clearButton = document.querySelector('#inventory-clear');
    const alertsRoot = document.querySelector('#inventory-alerts');
    let currentPage = 1;
    let totalPages = 1;
    let debounceTimer = null;

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const setStatus = (message, state = '') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = !message;
    };

    const renderAlerts = (alerts) => {
      if (!alertsRoot) return;
      const low = alerts?.low_stock || [];
      const empty = alerts?.out_of_stock || [];
      alertsRoot.innerHTML = `
        <article>
          <span>Bajo stock</span>
          <strong>${low.length}</strong>
          <small>${low.slice(0, 3).map((item) => escapeHtml(item.name)).join(', ') || 'Sin alertas'}</small>
        </article>
        <article>
          <span>Sin stock</span>
          <strong>${empty.length}</strong>
          <small>${empty.slice(0, 3).map((item) => escapeHtml(item.name)).join(', ') || 'Sin alertas'}</small>
        </article>
      `;
    };

    const renderPagination = (meta) => {
      currentPage = Number(meta?.page || currentPage);
      totalPages = Math.max(1, Number(meta?.total_pages || 1));
      const statusEl = pagination?.querySelector('[data-status]');
      const prev = pagination?.querySelector('[data-prev]');
      const next = pagination?.querySelector('[data-next]');
      if (statusEl) statusEl.textContent = `Pagina ${currentPage} de ${totalPages} · ${Number(meta?.total || 0)} productos`;
      if (prev) prev.disabled = currentPage <= 1;
      if (next) next.disabled = currentPage >= totalPages;
      if (pagination) pagination.hidden = totalPages <= 1;
    };

    const renderProducts = (products, meta) => {
      if (!table) return;

      table.innerHTML = products.map((product) => {
        const name = escapeHtml(product.name);
        const slug = escapeHtml(product.slug);
        const price = escapeHtml(product.price || '-');
        const isVariable = product.type === 'variable';
        const stockCount = Number(product.stock_quantity);
        const hasStockCount = Number.isFinite(stockCount) && stockCount >= 0;
        const variationStock = product.variation_stock || null;
        const stockLabel = isVariable
          ? product.is_in_stock
            ? variationStock?.total_managed_stock !== null && variationStock?.total_managed_stock !== undefined
              ? `Variaciones: ${variationStock.available_variations || 0} disponibles · ${variationStock.total_managed_stock} uds`
              : `Variaciones: ${variationStock?.available_variations || 0} disponibles`
            : 'Sin variaciones disponibles'
          : product.is_in_stock
            ? hasStockCount ? `Quedan ${stockCount}` : 'Disponible'
            : 'Sin stock';
        const stockState = product.is_in_stock ? (product.low_stock ? 'low' : 'available') : 'empty';

        return `
          <article class="row inventory-page-item">
            <div class="product-cell">
              <div class="product-thumb">
                ${product.image ? `<img src="${escapeHtml(product.image)}" alt="" loading="lazy">` : `<span aria-hidden="true">${name.slice(0, 1).toUpperCase()}</span>`}
              </div>
              <div class="product-meta">
                <strong>${name}</strong>
                <span>${slug}${product.sku ? ` · SKU ${escapeHtml(product.sku)}` : ''}</span>
              </div>
            </div>
            <span class="price-pill">${price}</span>
            <span class="stock-pill" data-stock="${stockState}">${stockLabel}</span>
            <a class="button button-secondary wp-edit-link" href="${escapeHtml(product.edit_url)}" target="_blank" rel="noreferrer">Editar</a>
          </article>
        `;
      }).join('');

      table.hidden = products.length === 0;
      setStatus(products.length === 0 ? 'No hay productos para mostrar.' : '');
      renderPagination(meta);
    };

    const loadInventory = async (pageNumber = currentPage) => {
      const { data: authPayload } = await cachedJson(meUrl, { credentials: 'include' }, 15_000);
      if (!authPayload.data?.can_access_backoffice) throw new Error('Sin permisos.');

      const url = new URL(inventoryUrl);
      url.searchParams.set('page', String(pageNumber));
      url.searchParams.set('per_page', '10');
      if (searchInput?.value.trim()) url.searchParams.set('search', searchInput.value.trim());
      if (stockSelect?.value) url.searchParams.set('stock', stockSelect.value);
      if (typeSelect?.value) url.searchParams.set('type', typeSelect.value);

      const { data: inventoryPayload } = await cachedJson(url.toString(), { credentials: 'include' }, 20_000);

      renderAlerts(inventoryPayload.alerts || {});
      renderProducts(inventoryPayload.data || [], inventoryPayload.meta || {});
      if (loading) loading.hidden = true;
      if (page) page.hidden = false;
    };

    const reloadFromFirstPage = () => {
      currentPage = 1;
      loadInventory(1).catch(showError);
    };

    const showError = (error) => {
      if (loading) loading.hidden = true;
      if (page) page.hidden = false;
      if (table) table.hidden = true;
      if (pagination) pagination.hidden = true;
      const message = error instanceof Error ? error.message : '';
      if (message === 'Sin permisos.' || message.includes('sesion') || message.includes('autentic')) {
        window.location.assign('/login');
        return;
      }
      setStatus(message || 'No se pudo cargar el inventario.', 'error');
    };

    filters?.addEventListener('submit', (event) => event.preventDefault());
    searchInput?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(reloadFromFirstPage, 350);
    });
    stockSelect?.addEventListener('change', reloadFromFirstPage);
    typeSelect?.addEventListener('change', reloadFromFirstPage);
    clearButton?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (stockSelect) stockSelect.value = '';
      if (typeSelect) typeSelect.value = '';
      reloadFromFirstPage();
    });
    pagination?.querySelector('[data-prev]')?.addEventListener('click', () => loadInventory(Math.max(1, currentPage - 1)).catch(showError));
    pagination?.querySelector('[data-next]')?.addEventListener('click', () => loadInventory(Math.min(totalPages, currentPage + 1)).catch(showError));

    loadInventory()
      .catch(showError);
  </script>
</BaseLayout>

<style>
  .inventory-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .inventory-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.15fr);
    gap: 40px;
    align-items: start;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  .notice,
  .row span {
    color: var(--color-body);
    line-height: 1.7;
  }

  .inventory-panel {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .notice[data-state="error"] {
    color: var(--color-danger);
  }

  .inventory-filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px 140px auto;
    gap: 10px;
    margin-bottom: 14px;
  }

  .inventory-filters input,
  .inventory-filters select {
    width: 100%;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-input);
    background: var(--color-canvas);
    padding: 10px 12px;
    font: inherit;
  }

  .alert-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }

  .alert-grid article {
    display: grid;
    gap: 4px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-surface-soft);
    padding: 12px;
  }

  .alert-grid span {
    color: var(--color-body);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .alert-grid strong {
    font-size: 1.4rem;
  }

  .alert-grid small {
    color: var(--color-body);
    line-height: 1.5;
  }

  #inventory-loading[hidden],
  #backoffice-page[hidden] {
    display: none;
  }

  .inventory-skeleton {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-item);
  }

  .inventory-skeleton article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px 112px;
    gap: 14px;
    align-items: center;
    background: var(--color-surface-soft);
    padding: 14px;
  }

  .inventory-skeleton span {
    height: 13px;
    border-radius: 999px;
    background: var(--color-surface-strong);
  }

  .inventory-skeleton article span:first-child {
    width: 100%;
    height: 54px;
    border-radius: var(--radius-item);
    background: linear-gradient(90deg, var(--color-surface-strong), #f9fafb, var(--color-surface-strong));
    background-size: 200% 100%;
    animation: inventory-skeleton-pulse 1.2s ease-in-out infinite;
  }

  @keyframes inventory-skeleton-pulse {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .table {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-hairline);
  }

  :global(.row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    gap: 14px;
    align-items: center;
    background: var(--color-canvas);
    padding: 12px 14px;
  }

  :global(.product-cell) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-width: 0;
  }

  :global(.product-thumb) {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-item);
    background: var(--color-surface-strong);
    color: var(--color-primary);
    font-weight: 800;
  }

  :global(.product-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.product-meta) {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  :global(.product-meta strong),
  :global(.product-meta span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.price-pill),
  :global(.stock-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    border-radius: var(--radius-pill);
    padding: 0 12px;
    font-size: 0.86rem;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.price-pill) {
    border: 1px solid #b8d7d1;
    background: #eef8f5;
    color: #126455 !important;
  }

  :global(.stock-pill[data-stock="available"]) {
    border: 1px solid #b9dfc3;
    background: #effaf1;
    color: #217a35 !important;
  }

  :global(.stock-pill[data-stock="low"]) {
    border: 1px solid #f3d29a;
    background: #fff7e8;
    color: #9a5a00 !important;
  }

  :global(.stock-pill[data-stock="empty"]) {
    border: 1px solid #f0b8b8;
    background: #fff0f0;
    color: var(--color-danger) !important;
  }

  .inventory-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 14px;
  }

  .inventory-pagination span {
    color: var(--color-body);
    font-size: 0.9rem;
    font-weight: 700;
  }

  :global(.wp-edit-link) {
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .inventory-shell,
    .inventory-filters,
    .alert-grid,
    :global(.row) {
      grid-template-columns: 1fr;
    }

    :global(.price-pill),
    :global(.stock-pill) {
      justify-content: flex-start;
    }
  }
</style>
