---
import ModuleDisabled from '../components/ModuleDisabled.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Carrito | ${siteConfig.name}`}>
  <SiteHeader active="carrito" />

  {
    siteConfig.features.shop ? (
      <main class="cart-view">
        <section class="page-shell cart-shell">
          <div>
            <p class="eyebrow">Carrito</p>
            <h1>Carrito</h1>
            <p class="lede">
              Revisa tu seleccion antes de continuar al pago. El stock y los precios se revalidan al crear el pedido.
            </p>
          </div>

          <section class="cart-panel" aria-live="polite">
            <div id="cart-skeleton" class="cart-skeleton" aria-hidden="true">
              <article><span></span><div><span></span><span></span></div><span></span></article>
              <article><span></span><div><span></span><span></span></div><span></span></article>
            </div>
            <div id="cart-items" class="cart-items"></div>
            <div id="cart-empty" class="empty-cart" hidden>
              <h2>Tu carrito esta vacio</h2>
              <p>Anade productos desde la tienda para probar el flujo base.</p>
              <a class="button button-primary" href="/tienda">Ir a tienda</a>
            </div>

            <aside class="cart-summary" id="cart-summary" hidden>
              <div class="coupon-row">
                <form id="coupon-form" class="coupon-form">
                  <input id="coupon-input" class="coupon-input" type="text" placeholder="Codigo de cupon" autocomplete="off" aria-label="Codigo de cupon" />
                  <button class="button button-secondary" type="submit" id="coupon-apply">Aplicar</button>
                </form>
                <p id="coupon-applied" class="coupon-applied" hidden>
                  <span id="coupon-applied-label"></span>
                  <button type="button" id="coupon-remove" class="coupon-remove" aria-label="Quitar cupon">&#x2715;</button>
                </p>
                <p id="coupon-error" class="coupon-error" hidden></p>
              </div>

              <div class="totals-block">
                <div class="totals-row">
                  <span>Subtotal</span>
                  <strong id="cart-subtotal">0,00 €</strong>
                </div>
                <div class="totals-row" id="discount-row" hidden>
                  <span id="discount-label">Descuento</span>
                  <strong id="cart-discount" class="discount-value"></strong>
                </div>
                <div class="totals-row">
                  <span id="shipping-label">Envio</span>
                  <strong id="cart-shipping">0,00 €</strong>
                </div>
                <div class="totals-row" id="tax-row" hidden>
                  <span id="tax-label">Impuestos</span>
                  <strong id="cart-tax"></strong>
                </div>
                <div class="totals-row totals-total">
                  <span>Total</span>
                  <strong id="cart-total">0,00 €</strong>
                </div>
              </div>

              <p id="cart-notice" class="cart-notice"></p>
            </aside>

            <div class="cart-actions" id="cart-actions" hidden>
              <a class="button button-primary" href="/checkout">Continuar compra</a>
              <button class="button button-secondary" id="clear-cart" type="button">Vaciar carrito</button>
            </div>
          </section>
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Carrito desactivado"
        summary="El carrito forma parte del modulo tienda. Puedes ocultarlo con PUBLIC_ENABLE_SHOP=false."
      />
    )
  }

  <script>
    import { clearCart, readActiveCart, readCartTotals, removeCartItem, updateCartItem } from '../lib/cart';
    import { csrfHeaders } from '../lib/security';
    import { tcgApi } from '../lib/tcg-api';
    import { addWishlistItem, readWishlist } from '../lib/wishlist';

    const _loginUrl = `/login?next=${encodeURIComponent('/carrito')}`;
    let wishlistIds = null;
    let cartItems = [];
    let totalsData = null;

    const itemsRoot     = document.querySelector('#cart-items');
    const emptyRoot     = document.querySelector('#cart-empty');
    const actionsRoot   = document.querySelector('#cart-actions');
    const summaryRoot   = document.querySelector('#cart-summary');
    const skeletonRoot  = document.querySelector('#cart-skeleton');
    const noticeRoot    = document.querySelector('#cart-notice');
    const clearButton   = document.querySelector('#clear-cart');

    const subtotalEl   = document.querySelector('#cart-subtotal');
    const discountRow  = document.querySelector('#discount-row');
    const discountLbl  = document.querySelector('#discount-label');
    const discountEl   = document.querySelector('#cart-discount');
    const shippingLbl  = document.querySelector('#shipping-label');
    const shippingEl   = document.querySelector('#cart-shipping');
    const taxRow       = document.querySelector('#tax-row');
    const taxLbl       = document.querySelector('#tax-label');
    const taxEl        = document.querySelector('#cart-tax');
    const totalEl      = document.querySelector('#cart-total');

    const couponForm    = document.querySelector('#coupon-form');
    const couponInput   = document.querySelector('#coupon-input');
    const couponApply   = document.querySelector('#coupon-apply');
    const couponApplied = document.querySelector('#coupon-applied');
    const couponLabel   = document.querySelector('#coupon-applied-label');
    const couponRemove  = document.querySelector('#coupon-remove');
    const couponError   = document.querySelector('#coupon-error');

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
    }[char]));

    const formatMoney = (value) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(value);

    const itemSubtotal = (item) => {
      const raw = Number(item.line_subtotal_raw);
      if (Number.isFinite(raw)) return raw;
      const price = Number(item.price_raw);
      return Number.isFinite(price) ? price * Number(item.quantity || 1) : 0;
    };

    const getMaxQuantity = (item) => {
      const max = Number(item.max_quantity);
      return Number.isFinite(max) && max > 0 ? max : 99;
    };

    const getItemNotice = (item) => {
      if (item.notice) return item.notice;
      if (item.is_in_stock === false) return 'Este producto esta sin stock.';
      const max = Number(item.max_quantity);
      if (Number.isFinite(max) && max > 0 && Number(item.quantity || 1) > max) return `Solo quedan ${max} unidades.`;
      return '';
    };

    const setWishlistButtonState = (button, isSaved) => {
      button.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
      button.setAttribute('aria-label', isSaved ? 'Guardado en wishlist' : 'Guardar en wishlist');
      button.classList.toggle('is-active', isSaved);
      button.classList.remove('is-error');
    };

    const hydrateWishlistState = async () => {
      try {
        const items = await readWishlist();
        wishlistIds = new Set(items.map((item) => Number(item.product_id)));
      } catch {
        wishlistIds = null;
      }
    };

    const saveForLater = async (button) => {
      if (!(wishlistIds instanceof Set)) {
        try {
          if (localStorage.getItem('tcg.authenticated') !== '1') {
            window.location.assign(_loginUrl);
            return;
          }
        } catch {
          window.location.assign(_loginUrl);
          return;
        }
      }

      const productId = Number(button.dataset.id);
      button.disabled = true;

      try {
        await addWishlistItem(productId);
        if (!(wishlistIds instanceof Set)) wishlistIds = new Set();
        wishlistIds.add(productId);
        setWishlistButtonState(button, true);
      } catch {
        button.classList.add('is-error');
        button.setAttribute('aria-label', 'No se pudo guardar en wishlist');
        window.setTimeout(() => button.classList.remove('is-error'), 1400);
      } finally {
        button.disabled = false;
      }
    };

    const renderTotals = (data) => {
      if (!data) {
        const sub = cartItems.reduce((sum, item) => sum + itemSubtotal(item), 0);
        if (subtotalEl) subtotalEl.textContent = formatMoney(sub);
        if (totalEl) totalEl.textContent = formatMoney(sub);
        if (discountRow) discountRow.hidden = true;
        if (taxRow) taxRow.hidden = true;
        if (shippingEl) shippingEl.textContent = '0,00 €';
        return;
      }

      if (subtotalEl) subtotalEl.textContent = data.subtotal || formatMoney(data.subtotal_raw || 0);
      if (shippingLbl) shippingLbl.textContent = data.shipping_label || 'Envio';
      if (shippingEl) shippingEl.textContent = data.shipping || '0,00 €';
      if (totalEl) totalEl.textContent = data.total || formatMoney(data.total_raw || 0);

      if (discountRow && discountEl) {
        const hasDiscount = data.discount_raw > 0;
        discountRow.hidden = !hasDiscount;
        if (hasDiscount) {
          if (discountLbl) discountLbl.textContent = data.coupon_label || 'Descuento';
          discountEl.textContent = data.discount || '';
        }
      }

      if (taxRow && taxEl) {
        const hasTax = data.tax_raw > 0;
        taxRow.hidden = !hasTax;
        if (hasTax) {
          if (taxLbl) taxLbl.textContent = data.tax_label || 'Impuestos';
          taxEl.textContent = data.tax || '';
        }
      }

      if (couponApplied && couponLabel) {
        if (data.coupon_code) {
          couponApplied.hidden = false;
          couponLabel.textContent = data.coupon_label || ('Cupon: ' + data.coupon_code.toUpperCase());
          if (couponInput) couponInput.value = data.coupon_code;
        } else {
          couponApplied.hidden = true;
          if (couponInput) couponInput.value = '';
        }
      }
    };

    const loadTotals = async () => {
      try {
        const isAuth = localStorage.getItem('tcg.authenticated') === '1';
        if (!isAuth) return;
        totalsData = await readCartTotals();
        renderTotals(totalsData);
      } catch {
        renderTotals(null);
      }
    };

    const setCouponLoading = (loading) => {
      if (couponApply) couponApply.disabled = loading;
      if (couponInput) couponInput.disabled = loading;
    };

    const showCouponError = (msg) => {
      if (couponError) {
        couponError.textContent = msg;
        couponError.hidden = !msg;
      }
    };

    couponForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = String(couponInput?.value || '').trim();
      if (!code) return;
      showCouponError('');
      setCouponLoading(true);

      try {
        const resp = await fetch(tcgApi.cartCoupon, {
          method: 'POST',
          credentials: 'include',
          headers: csrfHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify({ code }),
        });
        const payload = await resp.json().catch(() => ({}));

        if (!resp.ok) {
          showCouponError(payload.message || 'No se pudo aplicar el cupon.');
        } else {
          totalsData = payload.data || null;
          renderTotals(totalsData);
          showCouponError(totalsData?.coupon_error || '');
        }
      } catch {
        showCouponError('No se pudo aplicar el cupon. Intentalo de nuevo.');
      } finally {
        setCouponLoading(false);
      }
    });

    couponRemove?.addEventListener('click', async () => {
      showCouponError('');
      setCouponLoading(true);

      try {
        const resp = await fetch(tcgApi.cartCoupon, {
          method: 'DELETE',
          credentials: 'include',
          headers: csrfHeaders({}),
        });
        const payload = await resp.json().catch(() => ({}));
        totalsData = payload.data || null;
        renderTotals(totalsData);
        if (couponInput) couponInput.value = '';
      } catch {
        showCouponError('No se pudo quitar el cupon.');
      } finally {
        setCouponLoading(false);
      }
    });

    const renderCart = (items = cartItems) => {
      const hasItems = items.length > 0;

      if (skeletonRoot) skeletonRoot.hidden = true;
      if (emptyRoot) emptyRoot.style.display = hasItems ? 'none' : '';
      if (actionsRoot) actionsRoot.hidden = !hasItems;
      if (summaryRoot) summaryRoot.hidden = !hasItems;
      if (!itemsRoot) return;

      const hasIssues = items.some((item) => item.is_valid === false || Boolean(getItemNotice(item) && item.is_in_stock === false));

      if (noticeRoot) {
        noticeRoot.textContent = hasIssues
          ? 'Hay productos que necesitan revision antes de continuar.'
          : '';
        noticeRoot.dataset.state = hasIssues ? 'warning' : '';
      }
      actionsRoot?.querySelector('a[href="/checkout"]')?.toggleAttribute('aria-disabled', hasIssues);

      renderTotals(totalsData);

      itemsRoot.innerHTML = items.map((item) => {
        const id = Number(item.id);
        const name = escapeHtml(item.name || 'Producto');
        const price = escapeHtml(item.price || '-');
        const image = escapeHtml(item.image);
        const quantity = Number(item.quantity || 1);
        const maxQuantity = getMaxQuantity(item);
        const lineSubtotal = escapeHtml(item.line_subtotal || formatMoney(itemSubtotal(item)));
        const notice = getItemNotice(item);
        const isInvalid = item.is_valid === false || item.is_in_stock === false || quantity > maxQuantity;
        const saved = wishlistIds instanceof Set && wishlistIds.has(id);

        return `
          <article class="cart-item ${isInvalid ? 'has-issue' : ''}">
            <div class="item-media">
              ${item.image ? `<img src="${image}" alt="" loading="lazy">` : `<span aria-hidden="true">${name.slice(0, 1).toUpperCase()}</span>`}
            </div>
            <div class="item-info">
              <strong>${name}</strong>
              <p>${price} unidad · ${lineSubtotal}</p>
              ${notice ? `<small class="item-notice">${escapeHtml(notice)}</small>` : ''}
            </div>
            <div class="quantity-control" aria-label="Cantidad de ${name}">
              <button class="quantity-step" type="button" data-action="decrease" data-id="${id}" aria-label="Restar una unidad">-</button>
              <input class="quantity-input" type="number" min="1" max="${maxQuantity}" value="${quantity}" data-id="${id}" aria-label="Cantidad">
              <button class="quantity-step" type="button" data-action="increase" data-id="${id}" ${quantity >= maxQuantity ? 'disabled' : ''} aria-label="Sumar una unidad">+</button>
            </div>
            <div class="item-actions">
              <button class="wishlist-item ${saved ? 'is-active' : ''}" type="button" data-id="${id}" aria-pressed="${saved ? 'true' : 'false'}" aria-label="Guardar ${name} en wishlist">
                <svg class="heart-empty" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6Z"/></svg>
                <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.2 4.1 13.4A5.55 5.55 0 0 1 12 5.6a5.55 5.55 0 0 1 7.9 7.8L12 21.2Z"/></svg>
              </button>
              <button class="remove-item" type="button" data-id="${id}" aria-label="Quitar ${name}">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </article>
        `;
      }).join('');

      itemsRoot.querySelectorAll('.wishlist-item').forEach((btn) => {
        btn.addEventListener('click', () => saveForLater(btn));
      });

      const commitQuantity = async (id, quantity, control) => {
        const item = cartItems.find((current) => Number(current.id) === id);
        const max = item ? getMaxQuantity(item) : 99;
        const nextQuantity = Math.max(0, Math.min(max, Number(quantity) || 0));

        if (control) control.disabled = true;

        try {
          cartItems = await updateCartItem(id, nextQuantity);
          renderCart(cartItems);
          loadTotals();
        } catch (error) {
          if (noticeRoot) {
            noticeRoot.dataset.state = 'warning';
            noticeRoot.textContent = error instanceof Error ? error.message : 'No se pudo actualizar la cantidad.';
          }
          renderCart(cartItems);
        }
      };

      itemsRoot.querySelectorAll('.quantity-step').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = Number(btn.dataset.id);
          const item = cartItems.find((current) => Number(current.id) === id);
          const quantity = Number(item?.quantity || 1);
          const delta = btn.dataset.action === 'increase' ? 1 : -1;
          commitQuantity(id, quantity + delta, btn);
        });
      });

      itemsRoot.querySelectorAll('.quantity-input').forEach((input) => {
        input.addEventListener('change', () => {
          commitQuantity(Number(input.dataset.id), Number(input.value), input);
        });
      });

      itemsRoot.querySelectorAll('.remove-item').forEach((btn) => {
        btn.addEventListener('click', async () => {
          cartItems = await removeCartItem(Number(btn.dataset.id));
          renderCart(cartItems);
          loadTotals();
        });
      });
    };

    if (clearButton) {
      clearButton.addEventListener('click', async () => {
        cartItems = await clearCart();
        renderCart(cartItems);
        totalsData = null;
        renderTotals(null);
      });
    }

    window.addEventListener('tcg:cart-updated', async (event) => {
      cartItems = Array.isArray(event.detail?.items) ? event.detail.items : await readActiveCart();
      renderCart(cartItems);
    });
    window.addEventListener('tcg:wishlist-updated', (event) => {
      const detail = event.detail || {};
      const productId = Number(detail.productId);
      if (!productId || !detail.action) return;

      if (!(wishlistIds instanceof Set)) wishlistIds = new Set();
      if (detail.action === 'added') wishlistIds.add(productId);
      if (detail.action === 'removed') wishlistIds.delete(productId);
      renderCart(cartItems);
    });

    Promise.all([hydrateWishlistState(), readActiveCart()])
      .then(([, items]) => {
        cartItems = items;
        renderCart(cartItems);
        if (items.length > 0) loadTotals();
      })
      .catch(() => {
        cartItems = [];
        renderCart(cartItems);
      });
  </script>
</BaseLayout>

<style>
  .cart-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .cart-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: 40px;
    align-items: start;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  .empty-cart p {
    color: var(--color-body);
    line-height: 1.7;
  }

  .cart-panel {
    display: grid;
    gap: 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .cart-items {
    display: grid;
    gap: 12px;
  }

  .cart-skeleton {
    display: grid;
    gap: 12px;
  }

  .cart-skeleton[hidden] {
    display: none;
  }

  .cart-skeleton article {
    display: grid;
    grid-template-columns: 64px 1fr 68px;
    gap: 14px;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: 12px;
  }

  .cart-skeleton span {
    display: block;
    border-radius: 999px;
    background: var(--color-surface-strong);
  }

  .cart-skeleton article > span:first-child {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-item);
    background: linear-gradient(90deg, var(--color-surface-strong), #f9fafb, var(--color-surface-strong));
    background-size: 200% 100%;
    animation: cart-skeleton-pulse 1.2s ease-in-out infinite;
  }

  .cart-skeleton div {
    display: grid;
    gap: 10px;
  }

  .cart-skeleton div span:first-child { width: 72%; height: 14px; }
  .cart-skeleton div span:last-child  { width: 42%; height: 12px; }
  .cart-skeleton article > span:last-child { width: 68px; height: 30px; }

  @keyframes cart-skeleton-pulse {
    0%   { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .cart-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cart-summary {
    display: grid;
    gap: 14px;
    border-top: 1px solid var(--color-hairline);
    padding-top: 14px;
  }

  .cart-summary[hidden] { display: none; }

  /* Cupón */
  .coupon-row {
    display: grid;
    gap: 8px;
  }

  .coupon-form {
    display: flex;
    gap: 8px;
  }

  .coupon-input {
    flex: 1;
    height: 38px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    color: var(--color-ink);
    font: inherit;
    padding: 0 12px;
    font-size: 0.9rem;
  }

  .coupon-input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  .coupon-applied {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: #166534;
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: var(--radius-item);
    padding: 6px 12px;
  }

  .coupon-applied[hidden] { display: none; }

  .coupon-remove {
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.88rem;
    color: #166534;
    padding: 0 2px;
    line-height: 1;
  }

  .coupon-error {
    margin: 0;
    font-size: 0.84rem;
    color: #9a3412;
    font-weight: 600;
  }

  .coupon-error[hidden] { display: none; }

  /* Totales */
  .totals-block {
    display: grid;
    gap: 8px;
  }

  .totals-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.95rem;
  }

  .totals-row[hidden] { display: none; }

  .totals-row strong {
    color: var(--color-ink);
  }

  .discount-value {
    color: #166534 !important;
  }

  .totals-total {
    border-top: 1px solid var(--color-hairline);
    padding-top: 8px;
    font-size: 1rem;
  }

  .totals-total strong {
    color: var(--color-primary) !important;
    font-size: 1.2rem;
  }

  .cart-notice {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-body);
    line-height: 1.5;
  }

  .cart-notice[data-state="warning"] {
    color: #9a3412;
    font-weight: 600;
  }

  /* Elementos creados via innerHTML — necesitan :global() para saltarse el scope de Astro */
  :global(.cart-item) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto auto;
    gap: 14px;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: 12px;
  }

  :global(.cart-item.has-issue) {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: var(--radius-item);
    padding: 12px;
  }

  :global(.item-media) {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-item);
    background: var(--color-surface-strong);
    overflow: hidden;
    display: grid;
    place-items: center;
    flex-shrink: 0;
