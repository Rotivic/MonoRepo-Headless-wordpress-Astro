---
import ModuleDisabled from '../../components/ModuleDisabled.astro';
import Pagination from '../../components/Pagination.astro';
import ProductCard from '../../components/ProductCard.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shopApiInternal, type StoreProduct } from '../../lib/shop';

let products: StoreProduct[] = [];
let error = '';

if (siteConfig.features.shop) {
  try {
    const response = await fetch(`${shopApiInternal.products}?per_page=48`);

    if (!response.ok) {
      throw new Error(`WooCommerce respondio con ${response.status}`);
    }

    products = await response.json();
  } catch (caught) {
    error = caught instanceof Error ? caught.message : 'No se pudo cargar la tienda.';
  }
}
---

<BaseLayout title={`Tienda | ${siteConfig.name}`}>
  <SiteHeader active="tienda" />

  {
    siteConfig.features.shop ? (
      <main class="shop-view">
        <section class="page-shell shop-head">
          <p class="eyebrow">Tienda modular</p>
          <div>
            <h1>Catalogo</h1>
            <p>
              Vista base conectada a WooCommerce Store API. Puedes usarla como tienda,
              catalogo sin compra o desactivarla por entorno.
            </p>
          </div>
        </section>

        <section class="page-shell">
          {error && <p class="notice" data-state="error">{error}</p>}
          {!error && products.length === 0 && (
            <div class="empty-shop">
              <h2>No hay productos todavia</h2>
              <p>Crea productos en WordPress o ejecuta el seed demo de la plantilla.</p>
            </div>
          )}
          {products.length > 0 && (
            <>
              <div class="product-grid" id="product-grid">
                {products.map((product) => (
                  <div class="product-page-item">
                    <ProductCard product={product} />
                  </div>
                ))}
              </div>
              <Pagination id="shop-pagination" label="Paginacion de tienda" />
            </>
          )}
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Tienda desactivada"
        summary="Esta plantilla puede funcionar sin WooCommerce visible en el frontend. Activa PUBLIC_ENABLE_SHOP=true cuando el proyecto necesite catalogo o venta."
      />
    )
  }

  <script>
    import { setupLocalPagination } from '../../lib/pagination';
    import { tcgApi } from '../../lib/tcg-api';

    const _cartKey = 'tcg.cart.items';
    const _wishlistKey = 'tcg.wishlist.items';
    const _loginUrl = `/login?next=${encodeURIComponent('/tienda')}`;

    const _addCartItem = (item) => {
      try {
        const raw = localStorage.getItem(_cartKey);
        const items = raw ? JSON.parse(raw) : [];
        const existing = items.find((i) => i.id === item.id);
        if (existing) {
          existing.quantity += item.quantity;
        } else {
          items.push(item);
        }
        localStorage.setItem(_cartKey, JSON.stringify(items));
        window.dispatchEvent(new CustomEvent('tcg:cart-updated'));
      } catch {}
    };

    document.querySelectorAll('.add-to-cart').forEach((button) => {
      button.addEventListener('click', () => {
        _addCartItem({
          id: Number(button.dataset.id),
          slug: button.dataset.slug || '',
          name: button.dataset.name || 'Producto',
          price: button.dataset.price || '-',
          image: button.dataset.image || undefined,
          quantity: 1,
        });
        button.textContent = 'Anadido';
        window.setTimeout(() => { button.textContent = 'Anadir'; }, 1200);
      });
    });

    const _requireWishlistAuth = async () => {
      try {
        const response = await fetch(tcgApi.me, { credentials: 'include' });
        if (!response.ok) throw new Error('Guest');
        return true;
      } catch {
        try {
          localStorage.removeItem('tcg.authenticated');
          localStorage.removeItem('tcg.user.summary');
          localStorage.removeItem(_wishlistKey);
        } catch {}
        window.location.assign(_loginUrl);
        return false;
      }
    };

    document.querySelectorAll('.add-to-wishlist').forEach((button) => {
      button.addEventListener('click', async () => {
        button.disabled = true;
        const isAuthenticated = await _requireWishlistAuth();
        if (!isAuthenticated) return;

        try {
          const raw = localStorage.getItem(_wishlistKey);
          const items = raw ? JSON.parse(raw) : [];
          const item = {
            id: Number(button.dataset.id),
            slug: button.dataset.slug || '',
            name: button.dataset.name || 'Producto',
            price: button.dataset.price || '',
            image: button.dataset.image || undefined,
          };
          const exists = items.some((current) => current.id === item.id);
          const updated = exists ? items.filter((current) => current.id !== item.id) : [...items, item];
          localStorage.setItem(_wishlistKey, JSON.stringify(updated));
          window.dispatchEvent(new CustomEvent('tcg:wishlist-updated'));
        } catch {}

        button.textContent = 'Guardado';
        window.setTimeout(() => {
          button.textContent = 'Wishlist';
          button.disabled = false;
        }, 1200);
      });
    });

    setupLocalPagination({
      root: document,
      itemSelector: '.product-page-item',
      pagination: document.querySelector('#shop-pagination'),
      perPage: 12,
    });
  </script>
</BaseLayout>

<style>
  .shop-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .shop-head {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 32px;
    margin-bottom: 32px;
    align-items: end;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .shop-head p,
  .empty-shop p {
    max-width: 660px;
    margin: 16px 0 0;
    color: var(--color-body);
    line-height: 1.7;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .empty-shop,
  .notice {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 24px;
  }

  .notice[data-state="error"] {
    color: var(--color-danger);
  }

  @media (max-width: 860px) {
    .shop-head,
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
