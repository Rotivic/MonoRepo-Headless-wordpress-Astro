---
import ModuleDisabled from '../../components/ModuleDisabled.astro';
import Pagination from '../../components/Pagination.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title={`Tienda | ${siteConfig.name}`}>
  <SiteHeader active="tienda" />

  {
    siteConfig.features.shop ? (
      <main class="shop-view">
        <section class="page-shell shop-head">
          <p class="eyebrow">Tienda modular</p>
          <div class="shop-head-body">
            <h1>Catalogo</h1>
            <div class="shop-controls">
              <div class="search-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" id="shop-search" placeholder="Buscar productos..." autocomplete="off" />
              </div>
              <select id="shop-sort" class="shop-select" aria-label="Ordenar por">
                <option value="date:desc">Recientes</option>
                <option value="title:asc">Nombre A-Z</option>
                <option value="price:asc">Precio: menor primero</option>
                <option value="price:desc">Precio: mayor primero</option>
                <option value="instock">Disponibles primero</option>
              </select>
            </div>
          </div>
        </section>

        <section class="page-shell shop-body">
          <aside class="shop-filters" id="shop-filters">
            <div class="filter-group">
              <h3>Categoría</h3>
              <select id="filter-category" class="shop-select">
                <option value="">Todas las categorías</option>
              </select>
            </div>

            <div class="filter-group">
              <h3>Estado</h3>
              <label class="filter-check">
                <input type="checkbox" id="filter-featured" />
                Destacados
              </label>
              <label class="filter-check">
                <input type="checkbox" id="filter-on-sale" />
                En oferta
              </label>
              <label class="filter-check">
                <input type="checkbox" id="filter-instock" />
                Solo en stock
              </label>
            </div>

            <div class="filter-group">
              <h3>Precio</h3>
              <div class="price-inputs">
                <input type="number" id="filter-min-price" class="price-input" placeholder="Mín." min="0" step="1" />
                <span>—</span>
                <input type="number" id="filter-max-price" class="price-input" placeholder="Máx." min="0" step="1" />
              </div>
              <button type="button" id="apply-price" class="button button-secondary apply-price-btn">Aplicar precio</button>
            </div>

            <button type="button" id="clear-filters" class="button button-ghost clear-btn">Limpiar filtros</button>
          </aside>

          <div class="shop-main">
            <div class="shop-meta" id="shop-meta" hidden>
              <span id="shop-count" class="shop-count"></span>
            </div>
            <p class="notice" id="shop-error" data-state="error" hidden />
            <div class="empty-shop" id="shop-empty" hidden>
              <h2>Sin resultados</h2>
              <p>No hay productos que coincidan con los filtros actuales.</p>
            </div>
            <div class="product-grid skeleton-grid" id="shop-skeleton" aria-hidden="true">
              {Array.from({ length: 6 }).map(() => (
                <article class="product-skeleton">
                  <div class="skeleton-media" />
                  <div class="skeleton-body">
                    <span />
                    <span />
                    <span />
                  </div>
                </article>
              ))}
            </div>
            <div class="product-grid" id="product-grid" />
            <Pagination id="shop-pagination" label="Paginacion de tienda" />
          </div>
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Tienda desactivada"
        summary="Esta plantilla puede funcionar sin WooCommerce visible en el frontend. Activa PUBLIC_ENABLE_SHOP=true cuando el proyecto necesite catalogo o venta."
      />
    )
  }

  <script>
    import { shopApi, formatStorePrice, type StoreProduct } from '../../lib/shop';
    import { getProductBadgesHtml } from '../../lib/product-badges';
    import { addCartItem } from '../../lib/cart';
    import { addWishlistItem, readWishlist, removeWishlistItem } from '../../lib/wishlist';

    const _loginUrl = `/login?next=${encodeURIComponent('/tienda')}`;
    const PER_PAGE = 12;
    const _escMap: Record<string, string> = {
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
    };

    const grid        = document.querySelector<HTMLElement>('#product-grid');
    const skeleton    = document.querySelector<HTMLElement>('#shop-skeleton');
    const emptyEl     = document.querySelector<HTMLElement>('#shop-empty');
    const errorEl     = document.querySelector<HTMLElement>('#shop-error');
    const pagerRoot   = document.querySelector<HTMLElement>('#shop-pagination');
    const metaEl      = document.querySelector<HTMLElement>('#shop-meta');
    const countEl     = document.querySelector<HTMLElement>('#shop-count');
    const searchInput = document.querySelector<HTMLInputElement>('#shop-search');
    const sortSelect  = document.querySelector<HTMLSelectElement>('#shop-sort');
    const filterCategory  = document.querySelector<HTMLSelectElement>('#filter-category');
    const filterFeatured  = document.querySelector<HTMLInputElement>('#filter-featured');
    const filterOnSale    = document.querySelector<HTMLInputElement>('#filter-on-sale');
    const filterInStock   = document.querySelector<HTMLInputElement>('#filter-instock');
    const filterMinPrice  = document.querySelector<HTMLInputElement>('#filter-min-price');
    const filterMaxPrice  = document.querySelector<HTMLInputElement>('#filter-max-price');
    const applyPriceBtn   = document.querySelector<HTMLButtonElement>('#apply-price');
    const clearFiltersBtn = document.querySelector<HTMLButtonElement>('#clear-filters');
    const pagerPrev   = pagerRoot?.querySelector<HTMLButtonElement>('[data-pagination-prev]') ?? null;
    const pagerNext   = pagerRoot?.querySelector<HTMLButtonElement>('[data-pagination-next]') ?? null;
    const pagerStatus = pagerRoot?.querySelector<HTMLElement>('[data-pagination-status]') ?? null;

    let currentPage    = 1;
    let totalPages     = 1;
    let totalProducts  = 0;
    let wishlistIds: Set<number> | null = null;
    let searchDebounce: ReturnType<typeof setTimeout> | null = null;
    let appliedMinPrice: number | undefined;
    let appliedMaxPrice: number | undefined;

    const _escapeHtml = (value: unknown): string =>
      String(value ?? '').replace(/[&<>"']/g, (c) => _escMap[c] ?? c);

    const _htmlToText = (value: unknown): string => {
      const t = document.createElement('template');
      t.innerHTML = String(value ?? '');
      return t.content.textContent ?? '';
    };

    const _heartSvgs = `
      <svg class="heart-empty" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6Z"/></svg>
      <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.2 4.1 13.4A5.55 5.55 0 0 1 12 5.6a5.55 5.55 0 0 1 7.9 7.8L12 21.2Z"/></svg>
    `;

    const _productTemplate = (product: StoreProduct): string => {
      const image = product.images?.[0];
      const price = formatStorePrice(product.prices);
      const desc  = _escapeHtml(_htmlToText(product.short_description || product.description) || '');
      const safeName  = _escapeHtml(product.name);
      const safeSlug  = encodeURIComponent(product.slug ?? '');
      const safeImage = _escapeHtml(image?.src ?? '');
      const badges     = getProductBadgesHtml(product);
      const isVariable = product.type === 'variable';
      const isOutOfStock = !product.is_in_stock || product.stock_status === 'outofstock';

      const addToCartBtn = isVariable
        ? `<a class="button button-secondary" href="/producto?slug=${safeSlug}">Ver opciones</a>`
        : `<button class="button button-secondary add-to-cart" type="button"
            data-id="${product.id}" data-slug="${_escapeHtml(product.slug)}"
            data-name="${safeName}" data-price="${_escapeHtml(price)}" data-image="${safeImage}"
            ${isOutOfStock ? 'disabled' : ''}>
            ${isOutOfStock ? 'Agotado' : 'Añadir'}
          </button>`;

      return `
        <article class="product-card">
          <a class="media" href="/producto?slug=${safeSlug}" aria-label="Ver ${safeName}">
            ${image
              ? `<img src="${safeImage}" alt="${_escapeHtml(image.alt || product.name)}" loading="lazy">`
              : `<span>${safeName.slice(0, 1).toUpperCase()}</span>`}
            ${badges}
          </a>
          <div class="body">
            <div>
              <h2><a href="/producto?slug=${safeSlug}">${safeName}</a></h2>
              ${desc ? `<p>${desc}</p>` : '<p></p>'}
            </div>
            <div class="actions">
              <strong>${_escapeHtml(price)}</strong>
              ${addToCartBtn}
              <button class="wishlist-toggle add-to-wishlist" type="button"
                aria-label="Guardar ${safeName} en wishlist" aria-pressed="false"
                data-id="${product.id}">
                ${_heartSvgs}
              </button>
            </div>
          </div>
        </article>
      `;
    };

    const _buildUrl = (page: number): string => {
      const sortVal = sortSelect?.value ?? 'date:desc';
      let orderby = 'date';
      let order   = 'desc';
      let stockStatusFilter = '';

      if (sortVal === 'instock') {
        stockStatusFilter = 'instock';
      } else {
        const parts = sortVal.split(':');
        orderby = parts[0] ?? 'date';
        order   = parts[1] ?? 'desc';
      }

      const url = new URL(shopApi.products);
      url.searchParams.set('page', String(page));
      url.searchParams.set('per_page', String(PER_PAGE));
      url.searchParams.set('orderby', orderby);
      url.searchParams.set('order', order);

      const search = searchInput?.value.trim() ?? '';
      if (search) url.searchParams.set('search', search);

      const category = filterCategory?.value ?? '';
      if (category) url.searchParams.set('category', category);

      if (filterFeatured?.checked) url.searchParams.set('featured', 'true');
      if (filterOnSale?.checked)   url.searchParams.set('on_sale', 'true');

      const stockStatus = filterInStock?.checked ? 'instock' : stockStatusFilter;
      if (stockStatus) url.searchParams.set('stock_status', stockStatus);

      if (appliedMinPrice !== undefined) url.searchParams.set('min_price', String(Math.round(appliedMinPrice * 100)));
      if (appliedMaxPrice !== undefined) url.searchParams.set('max_price', String(Math.round(appliedMaxPrice * 100)));

      return url.toString();
    };

    const _updatePager = (): void => {
      if (!pagerRoot) return;
      pagerRoot.hidden = totalPages <= 1;
      if (pagerPrev) pagerPrev.disabled = currentPage <= 1;
      if (pagerNext) pagerNext.disabled = currentPage >= totalPages;
      if (pagerStatus) pagerStatus.textContent = `Página ${currentPage} de ${totalPages}`;
    };

    const _bindProductActions = (): void => {
      grid?.querySelectorAll<HTMLButtonElement>('.add-to-cart').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            await addCartItem({
              id: Number(btn.dataset['id']),
              slug: btn.dataset['slug'] ?? '',
              name: btn.dataset['name'] ?? 'Producto',
              price: btn.dataset['price'] ?? '-',
              image: btn.dataset['image'] || undefined,
              quantity: 1,
            });
            btn.textContent = 'Añadido';
          } catch (e) {
            btn.textContent = e instanceof Error ? e.message : 'Error';
          } finally {
            window.setTimeout(() => {
              btn.disabled = false;
              btn.textContent = 'Añadir';
            }, 1200);
          }
        });
      });

      grid?.querySelectorAll<HTMLButtonElement>('.add-to-wishlist').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!_requireWishlistAuth()) return;
          await _toggleWishlist(btn);
        });
      });
    };

    const _setWishlistBtn = (btn: HTMLButtonElement, saved: boolean): void => {
      btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      btn.setAttribute('aria-label', saved ? 'Quitar de wishlist' : 'Guardar en wishlist');
      btn.classList.toggle('is-active', saved);
      btn.classList.remove('is-error');
    };

    const _hydrateWishlistButtons = async (): Promise<void> => {
      try {
        const items = await readWishlist() as Array<{ product_id: number | string }>;
        wishlistIds = new Set<number>(items.map((i) => Number(i.product_id)));
        grid?.querySelectorAll<HTMLButtonElement>('.add-to-wishlist').forEach((btn) => {
          _setWishlistBtn(btn, (wishlistIds as Set<number>).has(Number(btn.dataset['id'])));
        });
      } catch {
        wishlistIds = null;
      }
    };

    const _requireWishlistAuth = (): boolean => {
      if (wishlistIds instanceof Set) return true;
      try {
        if (localStorage.getItem('tcg.authenticated') === '1') return true;
      } catch { /* ignore */ }
      window.location.assign(_loginUrl);
      return false;
    };

    const _toggleWishlist = async (btn: HTMLButtonElement): Promise<void> => {
      if (!(wishlistIds instanceof Set)) await _hydrateWishlistButtons();
      const id = Number(btn.dataset['id']);
      const wasSaved = wishlistIds instanceof Set && wishlistIds.has(id);
      btn.disabled = true;
      try {
        if (wasSaved) {
          await removeWishlistItem(id);
          (wishlistIds as Set<number>).delete(id);
        } else {
          await addWishlistItem(id);
          if (!(wishlistIds instanceof Set)) wishlistIds = new Set<number>();
          (wishlistIds as Set<number>).add(id);
        }
        _setWishlistBtn(btn, !wasSaved);
      } catch {
        btn.classList.add('is-error');
        btn.setAttribute('aria-label', 'No se pudo actualizar la wishlist');
        window.setTimeout(() => btn.classList.remove('is-error'), 1400);
      } finally {
        btn.disabled = false;
      }
    };

    window.addEventListener('tcg:wishlist-updated', (event: Event) => {
      const ev = event as CustomEvent<{ productId: number | string; action: string }>;
      const id = Number(ev.detail?.productId);
      const action = ev.detail?.action;
      if (!id || !action) return;
      if (!(wishlistIds instanceof Set)) wishlistIds = new Set<number>();
      if (action === 'added')   (wishlistIds as Set<number>).add(id);
      if (action === 'removed') (wishlistIds as Set<number>).delete(id);
      grid?.querySelectorAll<HTMLButtonElement>(`.add-to-wishlist[data-id="${id}"]`).forEach((btn) => {
        _setWishlistBtn(btn, action === 'added');
      });
    });

    const _setLoading = (loading: boolean): void => {
      if (skeleton) skeleton.hidden = !loading;
      if (grid)     grid.hidden     =  loading;
    };

    const _loadPage = async (page: number): Promise<void> => {
      currentPage = page;
      _setLoading(true);
      if (errorEl) errorEl.hidden = true;
      if (emptyEl) emptyEl.hidden = true;
      if (metaEl)  metaEl.hidden  = true;

      try {
        const url = _buildUrl(page);
        const response = await fetch(url);
        if (!response.ok) throw new Error(`WooCommerce respondió con ${response.status}`);
        const products = await response.json() as StoreProduct[];
        totalProducts = parseInt(response.headers.get('X-WP-Total') ?? '0', 10);
        totalPages    = parseInt(response.headers.get('X-WP-TotalPages') ?? '1', 10);

        _setLoading(false);

        if (products.length === 0) {
          if (grid)     grid.innerHTML  = '';
          if (emptyEl)  emptyEl.hidden  = false;
          if (pagerRoot) pagerRoot.hidden = true;
          if (metaEl)   metaEl.hidden   = true;
          return;
        }

        if (grid) {
          grid.innerHTML = products.map(_productTemplate).join('');
        }

        if (metaEl) {
          metaEl.hidden = false;
          if (countEl) {
            countEl.textContent = `${totalProducts} ${totalProducts === 1 ? 'producto' : 'productos'}`;
          }
        }

        _updatePager();
        _bindProductActions();
        _hydrateWishlistButtons();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (e) {
        _setLoading(false);
        if (grid)    grid.innerHTML = '';
        if (errorEl) {
          errorEl.textContent = e instanceof Error ? e.message : 'No se pudo cargar la tienda.';
          errorEl.hidden = false;
        }
        if (pagerRoot) pagerRoot.hidden = true;
      }
    };

    const _resetAndLoad = (): void => { void _loadPage(1); };

    const _loadCategories = async (): Promise<void> => {
      try {
        const url = `${shopApi.categories}?per_page=50&orderby=name&order=asc`;
        const response = await fetch(url);
        if (!response.ok) return;
        const cats = await response.json() as Array<{ slug: string; name: string; count: number }>;
        if (!filterCategory) return;
        cats.forEach((cat) => {
          if (!cat.count) return;
          const opt = document.createElement('option');
          opt.value = cat.slug;
          opt.textContent = `${cat.name} (${cat.count})`;
          filterCategory.appendChild(opt);
        });
        const urlCat = new URLSearchParams(window.location.search).get('category');
        if (urlCat) filterCategory.value = urlCat;
      } catch { /* ignore */ }
    };

    // Paginación
    pagerPrev?.addEventListener('click', () => {
      if (currentPage > 1) _loadPage(currentPage - 1);
    });
    pagerNext?.addEventListener('click', () => {
      if (currentPage < totalPages) _loadPage(currentPage + 1);
    });

    // Controles de filtro
    searchInput?.addEventListener('input', () => {
      if (searchDebounce) clearTimeout(searchDebounce);
      searchDebounce = setTimeout(_resetAndLoad, 350);
    });

    sortSelect?.addEventListener('change', _resetAndLoad);
    filterCategory?.addEventListener('change', _resetAndLoad);
    filterFeatured?.addEventListener('change', _resetAndLoad);
    filterOnSale?.addEventListener('change', _resetAndLoad);
    filterInStock?.addEventListener('change', _resetAndLoad);

    applyPriceBtn?.addEventListener('click', () => {
      const min = parseFloat(filterMinPrice?.value ?? '');
      const max = parseFloat(filterMaxPrice?.value ?? '');
      appliedMinPrice = !isNaN(min) && min > 0 ? min : undefined;
      appliedMaxPrice = !isNaN(max) && max > 0 ? max : undefined;
      _resetAndLoad();
    });

    clearFiltersBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (filterCategory) filterCategory.value = '';
      if (filterFeatured) filterFeatured.checked = false;
      if (filterOnSale) filterOnSale.checked = false;
      if (filterInStock) filterInStock.checked = false;
      if (filterMinPrice) filterMinPrice.value = '';
      if (filterMaxPrice) filterMaxPrice.value = '';
      if (sortSelect) sortSelect.value = 'date:desc';
      appliedMinPrice = undefined;
      appliedMaxPrice = undefined;
      _resetAndLoad();
    });

    // Arranque
    _loadCategories();
    _loadPage(1);
  </script>
</BaseLayout>

<style>
  .shop-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .shop-head {
    margin-bottom: 28px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
  }

  .shop-head-body {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-end;
  }

  .shop-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-left: auto;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-wrap svg {
    position: absolute;
    left: 12px;
    color: var(--color-muted);
    pointer-events: none;
  }

  #shop-search {
    width: 240px;
    height: 44px;
    padding: 0 14px 0 38px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.92rem;
  }

  #shop-search:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 82, 255, 0.12);
    outline: none;
  }

  .shop-select {
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
  }

  .shop-select:focus {
    border-color: var(--color-primary);
    outline: none;
  }

  /* Layout tienda: sidebar + contenido */
  .shop-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .shop-filters {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 20px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .filter-group h3 {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }

  .filter-group .shop-select {
    width: 100%;
    border-radius: var(--radius-input);
    height: 40px;
    font-size: 0.9rem;
  }

  .filter-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-ink);
    cursor: pointer;
  }

  .filter-check input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--color-primary);
    cursor: pointer;
  }

  .price-inputs {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .price-input {
    width: 0;
    flex: 1;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-input);
    background: var(--color-canvas);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.88rem;
  }

  .price-input:focus {
    border-color: var(--color-primary);
    outline: none;
  }

  .price-inputs span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .apply-price-btn {
    min-height: 36px;
    font-size: 0.85rem;
    padding: 0 14px;
    border-radius: var(--radius-pill);
  }

  .clear-btn {
    min-height: 36px;
    font-size: 0.85rem;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-muted);
    border: 1px solid var(--color-hairline);
  }

  .clear-btn:hover {
    background: var(--color-surface-strong);
    color: var(--color-ink);
  }

  .shop-meta {
    margin-bottom: 12px;
  }

  .shop-meta[hidden] {
    display: none;
  }

  .shop-count {
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .product-grid[hidden],
  .empty-shop[hidden],
  .notice[hidden] {
    display: none;
  }

  /* Product card */
  :global(.product-card) {
    position: relative;
    display: grid;
    overflow: hidden;
