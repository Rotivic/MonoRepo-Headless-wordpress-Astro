---
import { getCollection } from 'astro:content';
import FeatureCard from '../components/FeatureCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = (await getCollection('modules')).sort(
  (current, next) => current.data.order - next.data.order,
);
---

<BaseLayout>
  <SiteHeader active="home" />
  <main class="shell">
    <section class="status">
      <div>
        <p class="eyebrow">Headless stack</p>
        <h1>{siteConfig.name}</h1>
        <p class="lede">
          Frontend Astro conectado al backend WordPress Bedrock. Listo para iterar el
          marketplace, catalogo y experiencia para Flutter.
        </p>
      </div>

      <div class="starter-panel">
        <strong>Starter kit activo</strong>
        <span>Gestiona diagnostico, usuarios, formularios y contenido desde el panel de administracion.</span>
      </div>
    </section>

    <section class="grid" aria-label="Modulos iniciales">
      {
        modules.map((module) => (
          <FeatureCard
            index={module.data.order}
            title={module.data.title}
            summary={module.data.summary}
          />
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 56px 0;
  }

  .starter-panel {
    display: grid;
    gap: 8px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 18px;
  }

  .starter-panel strong {
    font-size: 1rem;
  }

  .starter-panel span {
    color: var(--color-body);
    line-height: 1.55;
  }

  .status {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.8fr);
    gap: 32px;
    align-items: end;
    min-height: 52vh;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.92;
  }

  .lede {
    max-width: 660px;
    margin: 24px 0 0;
    color: var(--color-body);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 44px;
  }

  @media (max-width: 820px) {
    .shell {
      padding: 32px 0;
    }

    .status,
    .grid {
      grid-template-columns: 1fr;
    }

    .status {
      min-height: auto;
    }
  }
</style>
