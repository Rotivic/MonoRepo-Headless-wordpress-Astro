---
import BackButton from '../components/BackButton.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Mis pedidos | ${siteConfig.name}`}>
  <SiteHeader active="home" />
  <main class="orders-view">
    <section class="page-shell orders-shell">
      <div>
        <BackButton fallback="/perfil" />
        <p class="eyebrow">Cuenta</p>
        <h1>Mis pedidos</h1>
        <p class="lede">Pedidos reales creados en WooCommerce desde tu cuenta.</p>
      </div>
      <section class="orders-panel">
        <div class="orders-skeleton" id="orders-skeleton" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="empty" id="orders-empty" hidden>
          <h2>No hay pedidos todavia</h2>
          <p>Cuando completes una compra, aqui se listaran estados, importes y productos.</p>
          <a class="button button-primary" href="/tienda">Ir a tienda</a>
        </div>
        <div class="orders-list" id="orders-list"></div>
      </section>
    </section>
  </main>

  <script define:vars={{ ordersUrl: tcgApi.orders }}>
    const skeleton = document.querySelector('#orders-skeleton');
    const empty = document.querySelector('#orders-empty');
    const list = document.querySelector('#orders-list');

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const renderOrders = (orders) => {
      if (!list || !empty) return;
      skeleton.hidden = true;
      empty.hidden = orders.length > 0;

      list.innerHTML = orders.map((order) => `
        <article class="order-card">
          <div>
            <strong>Pedido #${escapeHtml(order.number || order.id)}</strong>
            <p>${order.created_at ? new Date(order.created_at).toLocaleString('es-ES') : ''}</p>
          </div>
          <span>${Number(order.item_count || 0)} producto(s)</span>
          <span class="order-total">${escapeHtml(order.total || '')}</span>
          <span class="order-status">${escapeHtml(order.status_label || order.status || '')}</span>
        </article>
      `).join('');
    };

    fetch(ordersUrl, { credentials: 'include' })
      .then(async (response) => {
        if (response.status === 401 || response.status === 403) {
          window.location.assign(`/login?next=${encodeURIComponent('/mis-pedidos')}`);
          return null;
        }
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.message || 'No se pudieron cargar los pedidos.');
        return payload.data || [];
      })
      .then((orders) => {
        if (!orders) return;
        renderOrders(orders);
      })
      .catch(() => {
        skeleton.hidden = true;
        if (empty) empty.hidden = false;
      });
  </script>
</BaseLayout>

<style>
  .orders-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .orders-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 40px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  .empty p {
    color: var(--color-body);
    line-height: 1.6;
  }

  .orders-panel {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .orders-list {
    display: grid;
    gap: 12px;
  }

  .orders-skeleton {
    display: grid;
    gap: 12px;
  }

  .orders-skeleton span {
    display: block;
    height: 68px;
    border-radius: var(--radius-item);
    background: linear-gradient(90deg, #eef1f2 25%, #f7f8f8 37%, #eef1f2 63%);
    background-size: 400% 100%;
    animation: orders-loading 1.2s ease-in-out infinite;
  }

  @keyframes orders-loading {
    0% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0 50%;
    }
  }

  :global(.order-card) {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 16px;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    padding: 14px;
  }

  :global(.order-card p) {
    margin: 4px 0 0;
    color: var(--color-body);
  }

  :global(.order-total),
  :global(.order-status) {
    border-radius: var(--radius-pill);
    background: var(--color-surface-strong);
    padding: 7px 10px;
    font-size: 0.84rem;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.order-total) {
    color: var(--color-primary);
  }

  [hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .orders-shell,
    :global(.order-card) {
      grid-template-columns: 1fr;
    }
  }
</style>
