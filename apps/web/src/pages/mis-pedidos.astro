---
import BackButton from '../components/BackButton.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Mis pedidos | ${siteConfig.name}`}>
  <SiteHeader active="home" />
  <main class="orders-view">
    <section class="page-shell orders-shell">
      <div>
        <BackButton fallback="/perfil" />
        <p class="eyebrow">Cuenta</p>
        <h1>Mis pedidos</h1>
        <p class="lede">Vista base preparada para conectar pedidos reales de WooCommerce cuando el checkout este activo.</p>
      </div>
      <section class="orders-panel">
        <div class="orders-skeleton" id="orders-skeleton" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="empty" id="orders-empty" hidden>
          <h2>No hay pedidos todavia</h2>
          <p>Cuando se conecte el checkout, aqui se listaran pedidos, estados, importes y enlaces de detalle.</p>
          <a class="button button-primary" href="/tienda">Ir a tienda</a>
        </div>
        <div class="orders-list" id="orders-list"></div>
      </section>
    </section>
  </main>

  <script is:inline>
    const orderKey = 'tcg.last-order';
    const skeleton = document.querySelector('#orders-skeleton');
    const empty = document.querySelector('#orders-empty');
    const list = document.querySelector('#orders-list');

    try {
      const order = JSON.parse(localStorage.getItem(orderKey) || 'null');
      if (order && list && empty) {
        skeleton.hidden = true;
        empty.hidden = true;
        list.innerHTML = `
          <article class="order-card">
            <div>
              <strong>${order.id || 'Pedido demo'}</strong>
              <p>${new Date(order.created_at).toLocaleString('es-ES')}</p>
            </div>
            <span>${(order.items || []).length} producto(s)</span>
            <span>Demo</span>
          </article>
        `;
      } else {
        skeleton.hidden = true;
        if (empty) empty.hidden = false;
      }
    } catch {
      skeleton.hidden = true;
      if (empty) empty.hidden = false;
    }
  </script>
</BaseLayout>

<style>
  .orders-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .orders-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 40px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  .empty p {
    color: var(--color-body);
    line-height: 1.6;
  }

  .orders-panel {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .orders-list {
    display: grid;
    gap: 12px;
  }

  .orders-skeleton {
    display: grid;
    gap: 12px;
  }

  .orders-skeleton span {
    display: block;
    height: 68px;
    border-radius: var(--radius-item);
    background: linear-gradient(90deg, #eef1f2 25%, #f7f8f8 37%, #eef1f2 63%);
    background-size: 400% 100%;
    animation: orders-loading 1.2s ease-in-out infinite;
  }

  @keyframes orders-loading {
    0% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0 50%;
    }
  }

  :global(.order-card) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 16px;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    padding: 14px;
  }

  :global(.order-card p) {
    margin: 4px 0 0;
    color: var(--color-body);
  }

  [hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .orders-shell,
    :global(.order-card) {
      grid-template-columns: 1fr;
    }
  }
</style>
