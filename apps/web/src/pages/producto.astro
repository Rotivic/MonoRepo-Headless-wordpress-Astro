---
import ModuleDisabled from '../components/ModuleDisabled.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Producto | ${siteConfig.name}`}>
  <SiteHeader active="home" />

  {
    siteConfig.features.shop ? (
      <main class="product-view">
        <section class="page-shell">
          <article class="product-skeleton" id="product-skeleton" aria-hidden="true">
            <div class="skeleton-media" />
            <div class="skeleton-summary">
              <span class="skeleton-eyebrow" />
              <span class="skeleton-title" />
              <span class="skeleton-price" />
              <span />
              <span />
              <span class="skeleton-short" />
              <span class="skeleton-button" />
            </div>
          </article>

          <article class="product-detail" id="product-detail" hidden>
            <div class="media" id="product-media" />
            <div class="summary">
              <div class="badges-row">
                <div id="product-badges" />
                <button
                  id="product-wishlist"
                  class="wishlist-toggle product-wishlist-btn"
                  type="button"
                  aria-label="Guardar en wishlist"
                  aria-pressed="false"
                >
                  <svg class="heart-empty" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6Z"/></svg>
                  <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.2 4.1 13.4A5.55 5.55 0 0 1 12 5.6a5.55 5.55 0 0 1 7.9 7.8L12 21.2Z"/></svg>
                </button>
              </div>
              <p class="eyebrow categories" id="product-categories" />
              <h1 id="product-name">Producto</h1>
              <p class="price" id="product-price">-</p>
              <div class="stock-status" id="product-stock" />
              <div class="description" id="product-description" />

              <div id="variation-selectors" hidden />

              <div id="add-to-cart-wrap" hidden>
                <div class="qty-row">
                  <button type="button" id="qty-minus" class="qty-btn" aria-label="Reducir cantidad">−</button>
                  <input type="number" id="product-qty" value="1" min="1" max="99" aria-label="Cantidad" />
                  <button type="button" id="qty-plus" class="qty-btn" aria-label="Aumentar cantidad">+</button>
                </div>
                <button class="button button-primary" id="add-to-cart" type="button">Añadir al carrito</button>
              </div>
            </div>
          </article>

          <div class="notice" id="product-status" hidden />
        </section>

        <section class="page-shell related-section" id="related-section" hidden>
          <h2 class="related-title">También te puede gustar</h2>
          <div class="related-grid" id="related-grid" />
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Producto no disponible"
        summary="El modulo de tienda esta desactivado en este entorno."
      />
    )
  }

  <script>
    import { addCartItem } from '../lib/cart';
    import { addWishlistItem, readWishlist, removeWishlistItem } from '../lib/wishlist';
    import { formatStorePrice, shopApi, type StoreProduct } from '../lib/shop';
    import { getProductBadgesHtml } from '../lib/product-badges';

    const skeleton         = document.querySelector<HTMLElement>('#product-skeleton');
    const detail           = document.querySelector<HTMLElement>('#product-detail');
    const status           = document.querySelector<HTMLElement>('#product-status');
    const media            = document.querySelector<HTMLElement>('#product-media');
    const nameEl           = document.querySelector<HTMLElement>('#product-name');
    const priceEl          = document.querySelector<HTMLElement>('#product-price');
    const descEl           = document.querySelector<HTMLElement>('#product-description');
    const stockEl          = document.querySelector<HTMLElement>('#product-stock');
    const badgesEl         = document.querySelector<HTMLElement>('#product-badges');
    const categoriesEl     = document.querySelector<HTMLElement>('#product-categories');
    const variationSelectors = document.querySelector<HTMLElement>('#variation-selectors');
    const addWrap          = document.querySelector<HTMLElement>('#add-to-cart-wrap');
    const addButton        = document.querySelector<HTMLButtonElement>('#add-to-cart');
    const qtyInput         = document.querySelector<HTMLInputElement>('#product-qty');
    const qtyMinus         = document.querySelector<HTMLButtonElement>('#qty-minus');
    const qtyPlus          = document.querySelector<HTMLButtonElement>('#qty-plus');
    const relatedSection   = document.querySelector<HTMLElement>('#related-section');
    const relatedGrid      = document.querySelector<HTMLElement>('#related-grid');
    const wishlistBtn      = document.querySelector<HTMLButtonElement>('#product-wishlist');

    const _qs = new URLSearchParams(window.location.search);
    const slug = _qs.get('slug');
    const preselectVariationId = parseInt(_qs.get('variation_id') ?? '', 10) || null;
    let currentProduct: StoreProduct | null = null;
    let currentPrice = '-';
    let currentVariationId: number | null = null;
    let _abortVariation: AbortController | null = null;
    let wishlistIds: Set<number> | null = null;
    const _loginUrl = `/login?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;

    const _escMap: Record<string, string> = {
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
    };
    const _esc = (v: unknown): string =>
      String(v ?? '').replace(/[&<>"']/g, (c) => _escMap[c] ?? c);

    const _htmlToText = (v: unknown): string => {
      const t = document.createElement('template');
      t.innerHTML = String(v ?? '');
      return t.content.textContent ?? '';
    };

    const _setStatus = (msg: string, state = ''): void => {
      if (skeleton) skeleton.hidden = true;
      if (detail)   detail.hidden   = true;
      if (status) { status.textContent = msg; status.dataset['state'] = state; status.hidden = false; }
    };

    const _stockHtml = (p: StoreProduct): string => {
      if (!p.is_in_stock || p.stock_status === 'outofstock')
        return `<span class="stock-badge stock-out">Agotado</span>`;
      if (p.stock_status === 'onbackorder')
        return `<span class="stock-badge stock-backorder">Disponible por encargo</span>`;
      if (p.low_stock_remaining !== null && p.low_stock_remaining > 0)
        return `<span class="stock-badge stock-low">Bajo stock — quedan ${p.low_stock_remaining}</span>`;
      if (p.stock_quantity !== null && p.stock_quantity > 0)
        return `<span class="stock-badge stock-ok">En stock (${p.stock_quantity} disponibles)</span>`;
      return `<span class="stock-badge stock-ok">En stock</span>`;
    };

    const _categoriesHtml = (p: StoreProduct): string => {
      if (!p.categories?.length) return '';
      const links = p.categories
        .map((c) => `<a href="/tienda?category=${encodeURIComponent(c.slug)}">${_esc(c.name)}</a>`)
        .join(' · ');
      return `Categorías: ${links}`;
    };

    const _syncQty = (): void => {
      if (!qtyInput) return;
      const val = parseInt(qtyInput.value, 10);
      const max = parseInt(qtyInput.max, 10) || 99;
      if (qtyMinus) qtyMinus.disabled = val <= 1;
      if (qtyPlus)  qtyPlus.disabled  = val >= max;
    };

    const _updateQtyControls = (p: StoreProduct): void => {
      if (!qtyInput) return;
      const max = p.stock_quantity !== null && p.stock_quantity > 0 ? p.stock_quantity : 99;
      qtyInput.max   = String(max);
      qtyInput.value = '1';
      _syncQty();
    };

    // ── Wishlist ─────────────────────────────────────────────────

    const _setWishlistBtn = (btn: HTMLButtonElement, saved: boolean): void => {
      btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      btn.setAttribute('aria-label', saved ? 'Quitar de wishlist' : 'Guardar en wishlist');
      btn.classList.toggle('is-active', saved);
      btn.classList.remove('is-error');
    };

    // Devuelve el ID que debe usarse para la wishlist del producto principal:
    // variación seleccionada si existe, padre en caso contrario.
    const _activeWishlistId = (): number =>
      currentVariationId ?? currentProduct?.id ?? 0;

    const _hydrateWishlist = async (): Promise<void> => {
      try {
        const items = await readWishlist() as Array<{ product_id: number | string }>;
        wishlistIds = new Set<number>(items.map((i) => Number(i.product_id)));
        if (wishlistBtn) _setWishlistBtn(wishlistBtn, wishlistIds.has(_activeWishlistId()));
        relatedGrid?.querySelectorAll<HTMLButtonElement>('.add-to-wishlist').forEach((btn) => {
          _setWishlistBtn(btn, (wishlistIds as Set<number>).has(Number(btn.dataset['id'])));
        });
      } catch {
        wishlistIds = null;
      }
    };

    const _requireAuth = (): boolean => {
      if (wishlistIds instanceof Set) return true;
      try { if (localStorage.getItem('tcg.authenticated') === '1') return true; } catch { /* ignore */ }
      window.location.assign(_loginUrl);
      return false;
    };

    const _toggleWishlist = async (btn: HTMLButtonElement, productId: number): Promise<void> => {
      if (!_requireAuth()) return;
      if (!(wishlistIds instanceof Set)) await _hydrateWishlist();
      const wasSaved = wishlistIds instanceof Set && wishlistIds.has(productId);
      btn.disabled = true;
      try {
        if (wasSaved) {
          await removeWishlistItem(productId);
          (wishlistIds as Set<number>).delete(productId);
        } else {
          await addWishlistItem(productId);
          if (!(wishlistIds instanceof Set)) wishlistIds = new Set<number>();
          (wishlistIds as Set<number>).add(productId);
        }
        _setWishlistBtn(btn, !wasSaved);
      } catch {
        btn.classList.add('is-error');
        window.setTimeout(() => btn.classList.remove('is-error'), 1400);
      } finally {
        btn.disabled = false;
      }
    };

    // ── Variaciones ──────────────────────────────────────────────

    const _getSelected = (): Record<string, string> => {
      const result: Record<string, string> = {};
      variationSelectors?.querySelectorAll<HTMLSelectElement>('.variation-select').forEach((s) => {
        result[s.dataset['attr'] ?? ''] = s.value;
      });
      return result;
    };

    const _matchVariation = (product: StoreProduct, selected: Record<string, string>): number | null => {
      for (const v of product.variations) {
        const matches = Object.entries(selected).every(([attrName, val]) => {
          const varAttr = v.attributes.find((a) => a.name === attrName);
          // empty value in variation = "any"
          return !varAttr || varAttr.value === '' || varAttr.value.toLowerCase() === val.toLowerCase();
        });
        if (matches) return v.id;
      }
      return null;
    };

    const _onVariationChange = async (product: StoreProduct): Promise<void> => {
      const selected = _getSelected();
      const allPicked = Object.values(selected).every((v) => v !== '');

      if (!allPicked) {
        if (addButton) { addButton.disabled = true; addButton.textContent = 'Selecciona todas las opciones'; }
        if (priceEl)   priceEl.textContent = formatStorePrice(product.prices);
        if (stockEl)   stockEl.innerHTML   = '';
        currentVariationId = null;
        // Sin variación seleccionada: corazón refleja el estado del padre.
        if (wishlistBtn && wishlistIds instanceof Set) {
          _setWishlistBtn(wishlistBtn, wishlistIds.has(product.id));
        }
        return;
      }

      const varId = _matchVariation(product, selected);
      if (!varId) {
        if (addButton) { addButton.disabled = true; addButton.textContent = 'Combinación no disponible'; }
        currentVariationId = null;
        if (wishlistBtn && wishlistIds instanceof Set) {
          _setWishlistBtn(wishlistBtn, wishlistIds.has(product.id));
        }
        return;
      }

      if (_abortVariation) _abortVariation.abort();
      _abortVariation = new AbortController();

      try {
        if (addButton) { addButton.disabled = true; addButton.textContent = 'Cargando…'; }
        const res = await fetch(`${shopApi.products}/${varId}`, { signal: _abortVariation.signal });
        if (!res.ok) throw new Error('error');
        const variation = await res.json() as StoreProduct;

        currentPrice       = formatStorePrice(variation.prices);
        currentVariationId = varId;

        if (priceEl) priceEl.textContent = currentPrice;
        if (stockEl) stockEl.innerHTML   = _stockHtml(variation);
        _updateQtyControls(variation);

        const outOfStock = !variation.is_in_stock || variation.stock_status === 'outofstock';
        if (addButton) {
          addButton.disabled    = outOfStock;
          addButton.textContent = outOfStock ? 'Agotado' : 'Añadir al carrito';
        }

        // Actualizar corazón: refleja si ESTA variación está en la wishlist.
        if (wishlistBtn && wishlistIds instanceof Set) {
          _setWishlistBtn(wishlistBtn, wishlistIds.has(varId));
        }
      } catch (e) {
        if ((e as Error).name === 'AbortError') return;
        if (addButton) { addButton.disabled = true; addButton.textContent = 'Error al cargar variación'; }
        currentVariationId = null;
      }
    };

    const _setupVariationSelectors = (product: StoreProduct): void => {
      if (!variationSelectors) return;
      const varAttrs = (product.attributes ?? []).filter((a) => a.has_variations);
      if (!varAttrs.length) return;

      variationSelectors.innerHTML = varAttrs.map((attr) => `
        <div class="variation-field">
          <label class="variation-label">${_esc(attr.name)}</label>
          <select class="variation-select shop-select" data-attr="${_esc(attr.name)}">
            <option value="">Selecciona ${_esc(attr.name)}</option>
            ${attr.terms.map((t) => `<option value="${_esc(t.slug)}">${_esc(t.name)}</option>`).join('')}
          </select>
        </div>
      `).join('');

      variationSelectors.hidden = false;

      variationSelectors.querySelectorAll<HTMLSelectElement>('.variation-select').forEach((s) => {
        s.addEventListener('change', () => { void _onVariationChange(product); });
      });

      if (addWrap)   addWrap.hidden   = false;
      if (addButton) { addButton.disabled = true; addButton.textContent = 'Selecciona todas las opciones'; }

      // Pre-seleccionar variación si viene de wishlist (?variation_id=...)
      if (preselectVariationId) {
        const target = product.variations.find((v) => v.id === preselectVariationId);
        if (target) {
          target.attributes.forEach((attr) => {
            if (!attr.value) return;
            const sel = variationSelectors?.querySelector<HTMLSelectElement>(
              `.variation-select[data-attr="${attr.name}"]`
            );
            if (sel) sel.value = attr.value;
          });
          void _onVariationChange(product);
        }
      }
    };

    // ── Productos relacionados ────────────────────────────────────

    const _heartSvgs = `
      <svg class="heart-empty" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6Z"/></svg>
      <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.2 4.1 13.4A5.55 5.55 0 0 1 12 5.6a5.55 5.55 0 0 1 7.9 7.8L12 21.2Z"/></svg>
    `;

    const _relatedCardHtml = (p: StoreProduct): string => {
      const image = p.images?.[0];
      const price = formatStorePrice(p.prices);
      const safeName  = _esc(p.name);
      const safeSlug  = encodeURIComponent(p.slug ?? '');
      const safeImage = _esc(image?.src ?? '');
      const isOut  = !p.is_in_stock || p.stock_status === 'outofstock';
      const isVar  = p.type === 'variable';
      const btn = isVar
        ? `<a class="button button-secondary" href="/producto?slug=${safeSlug}">Ver opciones</a>`
        : `<button class="button button-secondary add-to-cart" type="button"
            data-id="${p.id}" data-slug="${_esc(p.slug)}"
            data-name="${safeName}" data-price="${_esc(price)}" data-image="${safeImage}"
            ${isOut ? 'disabled' : ''}>${isOut ? 'Agotado' : 'Añadir'}</button>`;
      return `
        <article class="product-card">
          <a class="media" href="/producto?slug=${safeSlug}" aria-label="Ver ${safeName}">
            ${image ? `<img src="${safeImage}" alt="${_esc(image.alt || p.name)}" loading="lazy">` : `<span>${safeName.slice(0,1).toUpperCase()}</span>`}
          </a>
          <div class="body">
            <div><h3><a href="/producto?slug=${safeSlug}">${safeName}</a></h3></div>
            <div class="actions">
              <strong>${_esc(price)}</strong>${btn}
              <button class="wishlist-toggle add-to-wishlist" type="button"
                aria-label="Guardar ${safeName} en wishlist" aria-pressed="false"
                data-id="${p.id}">${_heartSvgs}</button>
            </div>
          </div>
        </article>`;
    };

    const _bindRelatedActions = (): void => {
      relatedGrid?.querySelectorAll<HTMLButtonElement>('.add-to-cart').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            await addCartItem({
              id: Number(btn.dataset['id']),
              slug: btn.dataset['slug'] ?? '',
              name: btn.dataset['name'] ?? 'Producto',
              price: btn.dataset['price'] ?? '-',
              image: btn.dataset['image'] || undefined,
              quantity: 1,
            });
            btn.textContent = 'Añadido';
          } catch (e) {
            btn.textContent = e instanceof Error ? e.message : 'Error';
          } finally {
            window.setTimeout(() => { btn.disabled = false; btn.textContent = 'Añadir'; }, 1200);
          }
        });
      });

      relatedGrid?.querySelectorAll<HTMLButtonElement>('.add-to-wishlist').forEach((btn) => {
        const id = Number(btn.dataset['id']);
        if (wishlistIds instanceof Set) _setWishlistBtn(btn, wishlistIds.has(id));
        btn.addEventListener('click', () => { void _toggleWishlist(btn, id); });
      });
    };

    const _loadRelated = async (p: StoreProduct): Promise<void> => {
      const cat = p.categories?.[0];
      if (!cat || !relatedSection || !relatedGrid) return;
      try {
        const url = new URL(shopApi.products);
        url.searchParams.set('category', cat.slug);
        url.searchParams.set('exclude', String(p.id));
        url.searchParams.set('per_page', '4');
        url.searchParams.set('orderby', 'popularity');
        const res = await fetch(url.toString());
        if (!res.ok) return;
        const related = await res.json() as StoreProduct[];
        if (!related.length) return;
        relatedGrid.innerHTML = related.map(_relatedCardHtml).join('');
        relatedSection.hidden = false;
        _bindRelatedActions();
      } catch { /* ignore */ }
    };

    // ── Carga principal ───────────────────────────────────────────

    const _loadProduct = async (): Promise<void> => {
      if (!slug) { _setStatus('Producto no encontrado.', 'error'); return; }
      try {
        const res = await fetch(`${shopApi.products}?slug=${encodeURIComponent(slug)}`);
        if (!res.ok) throw new Error(`WooCommerce respondió con ${res.status}`);
        const list = await res.json() as StoreProduct[];
        let product = list[0] ?? null;
        if (!product) { _setStatus('Producto no encontrado.', 'error'); return; }

        // El endpoint de listado (?slug=) puede devolver atributos incompletos
        // para productos variables. Refetching por ID garantiza datos completos.
        if (product.type === 'variable') {
          try {
            const detailRes = await fetch(`${shopApi.products}/${product.id}`);
            if (detailRes.ok) {
              product = await detailRes.json() as StoreProduct;
            }
          } catch { /* usar datos del listado si falla */ }
        }

        currentProduct = product;
        const p = currentProduct;
        const image = p.images?.[0];
        currentPrice = formatStorePrice(p.prices);

        if (media) {
          media.innerHTML = image
            ? `<img src="${_esc(image.src)}" alt="${_esc(image.alt || p.name)}">`
            : `<span>${_esc(p.name).slice(0, 1).toUpperCase()}</span>`;
        }

        if (badgesEl)     badgesEl.innerHTML     = getProductBadgesHtml(p);
        if (nameEl)       nameEl.textContent      = p.name;
        if (priceEl)      priceEl.textContent     = currentPrice;
        if (stockEl)      stockEl.innerHTML       = _stockHtml(p);
        if (categoriesEl) categoriesEl.innerHTML  = _categoriesHtml(p);
        if (descEl)       descEl.textContent      = _htmlToText(p.description || p.short_description || '');

        const isVariable   = p.type === 'variable';
        const isOutOfStock = !p.is_in_stock || p.stock_status === 'outofstock';

        if (isVariable) {
          _setupVariationSelectors(p);
          // price/stock shown initially from parent; updates on selection
        } else {
          if (variationSelectors) variationSelectors.hidden = true;
          if (addWrap) addWrap.hidden = false;
          _updateQtyControls(p);
          if (addButton) {
            addButton.disabled    = isOutOfStock;
            addButton.textContent = isOutOfStock ? 'Agotado' : 'Añadir al carrito';
          }
        }

        if (status)  status.hidden  = true;
        if (skeleton) skeleton.hidden = true;
        if (detail)   detail.hidden   = false;

        void _hydrateWishlist();
        void _loadRelated(p);
      } catch (e) {
        _setStatus(e instanceof Error ? e.message : 'No se pudo cargar el producto.', 'error');
      }
    };

    // ── Wishlist botón principal ──────────────────────────────────
    // Suscrito una sola vez al inicio; lee currentProduct en el momento del click.
    wishlistBtn?.addEventListener('click', () => {
      if (!currentProduct || !wishlistBtn) return;
      void _toggleWishlist(wishlistBtn, _activeWishlistId());
    });

    // ── Controles de cantidad ─────────────────────────────────────

    qtyMinus?.addEventListener('click', () => {
      if (!qtyInput) return;
      const val = parseInt(qtyInput.value, 10);
      if (val > 1) { qtyInput.value = String(val - 1); _syncQty(); }
    });

    qtyPlus?.addEventListener('click', () => {
      if (!qtyInput) return;
      const val = parseInt(qtyInput.value, 10);
      const max = parseInt(qtyInput.max, 10) || 99;
      if (val < max) { qtyInput.value = String(val + 1); _syncQty(); }
    });

    qtyInput?.addEventListener('change', () => {
      if (!qtyInput) return;
      const max = parseInt(qtyInput.max, 10) || 99;
      let val = parseInt(qtyInput.value, 10);
      if (isNaN(val) || val < 1) val = 1;
      if (val > max) val = max;
      qtyInput.value = String(val);
      _syncQty();
    });

    addButton?.addEventListener('click', async () => {
      if (!currentProduct || !addButton || addButton.disabled) return;
      const qty  = parseInt(qtyInput?.value ?? '1', 10);
      const isVar = currentProduct.type === 'variable';
      // Para variables, usa el variation ID; para simples, el product ID
      const cartId = isVar ? (currentVariationId ?? 0) : currentProduct.id;
      if (isVar && !currentVariationId) return;

      addButton.disabled = true;
      try {
        await addCartItem({
          id: cartId,
          slug: currentProduct.slug,
          name: currentProduct.name,
          price: currentPrice,
          image: currentProduct.images?.[0]?.src,
          quantity: qty,
        });
        addButton.textContent = qty > 1 ? `${qty} añadidos` : 'Añadido al carrito';
      } catch (e) {
        addButton.textContent = e instanceof Error ? e.message : 'No se pudo añadir';
      } finally {
        window.setTimeout(() => {
          if (!addButton || !currentProduct) return;
          const isOut = !currentProduct.is_in_stock || currentProduct.stock_status === 'outofstock';
          addButton.disabled    = isOut && !currentVariationId;
          addButton.textContent = 'Añadir al carrito';
        }, 1400);
      }
    });

    void _loadProduct();

    // ── Bus de wishlist ───────────────────────────────────────────
    // Escucha cambios de cualquier vista (off-canvas, tienda, wishlist…)
    // y sincroniza los botones de corazón de esta página sin re-fetch.
    window.addEventListener('tcg:wishlist-updated', (event: Event) => {
      const ev = event as CustomEvent<{ productId?: number | string; action?: string } | null>;
      const detail = ev.detail;

      if (detail?.productId && detail?.action) {
        // Actualización incremental: un item concreto cambió
        const id     = Number(detail.productId);
        const added  = detail.action === 'added';

        if (!(wishlistIds instanceof Set)) wishlistIds = new Set<number>();
        if (added) (wishlistIds as Set<number>).add(id);
        else       (wishlistIds as Set<number>).delete(id);

        // Botón principal: coincide si el ID es el activo (variación seleccionada o padre)
        if (wishlistBtn && _activeWishlistId() === id) {
          _setWishlistBtn(wishlistBtn, added);
        }

        // Botones de productos relacionados
        relatedGrid?.querySelectorAll<HTMLButtonElement>(`.add-to-wishlist[data-id="${id}"]`).forEach((btn) => {
          _setWishlistBtn(btn, added);
        });
      } else {
        // Sin detail → refresco total (logout, acción externa…)
        wishlistIds = null;
        if (currentProduct) {
          // Si ya tenemos el producto cargado, re-hidratamos en lugar de dejar vacío.
          void _hydrateWishlist();
        } else {
          if (wishlistBtn) _setWishlistBtn(wishlistBtn, false);
          relatedGrid?.querySelectorAll<HTMLButtonElement>('.add-to-wishlist').forEach((btn) => {
            _setWishlistBtn(btn, false);
          });
        }
      }
    });
  </script>
</BaseLayout>

