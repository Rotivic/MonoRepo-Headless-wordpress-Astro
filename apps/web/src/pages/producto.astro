---
import ModuleDisabled from '../components/ModuleDisabled.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Producto | ${siteConfig.name}`}>
  <SiteHeader active="home" />

  {
    siteConfig.features.shop ? (
      <main class="product-view">
        <section class="page-shell">
          <article class="product-skeleton" id="product-skeleton" aria-hidden="true">
            <div class="skeleton-media"></div>
            <div class="skeleton-summary">
              <span class="skeleton-eyebrow"></span>
              <span class="skeleton-title"></span>
              <span class="skeleton-price"></span>
              <span></span>
              <span></span>
              <span class="skeleton-short"></span>
              <span class="skeleton-button"></span>
            </div>
          </article>

          <article class="product-detail" id="product-detail" hidden>
            <div class="media" id="product-media"></div>
            <div class="summary">
              <p class="eyebrow">Producto</p>
              <h1 id="product-name">Producto</h1>
              <p class="price" id="product-price">-</p>
              <div class="description" id="product-description"></div>
              <button class="button button-primary" id="add-to-cart" type="button">Añadir al carrito</button>
            </div>
          </article>

          <div class="notice" id="product-status" hidden></div>
        </section>
      </main>
    ) : (
      <ModuleDisabled
        title="Producto no disponible"
        summary="El modulo de tienda esta desactivado en este entorno."
      />
    )
  }

  <script>
    import { addCartItem } from '../lib/cart';
    import { formatStorePrice, shopApi } from '../lib/shop';

    const skeleton = document.querySelector('#product-skeleton');
    const detail = document.querySelector('#product-detail');
    const status = document.querySelector('#product-status');
    const media = document.querySelector('#product-media');
    const name = document.querySelector('#product-name');
    const price = document.querySelector('#product-price');
    const description = document.querySelector('#product-description');
    const addButton = document.querySelector('#add-to-cart');

    const slug = new URLSearchParams(window.location.search).get('slug');
    let currentProduct = null;
    let currentPrice = '-';

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const stripHtml = (value) => {
      const template = document.createElement('template');
      template.innerHTML = String(value || '');
      return template.content.textContent || '';
    };

    const setStatus = (message, state = '') => {
      if (skeleton instanceof HTMLElement) {
        skeleton.hidden = true;
      }
      if (status instanceof HTMLElement) {
        status.textContent = message;
        status.dataset.state = state;
        status.hidden = false;
      }
      if (detail instanceof HTMLElement) {
        detail.hidden = true;
      }
    };

    const loadProduct = async () => {
      if (!slug) {
        setStatus('Producto no encontrado.', 'error');
        return;
      }

      try {
        const response = await fetch(`${shopApi.products}?slug=${encodeURIComponent(slug)}`);

        if (!response.ok) {
          throw new Error(`WooCommerce respondio con ${response.status}`);
        }

        const products = await response.json();
        currentProduct = products[0] ?? null;

        if (!currentProduct) {
          setStatus('Producto no encontrado.', 'error');
          return;
        }

        const image = currentProduct.images?.[0];
        currentPrice = formatStorePrice(currentProduct.prices);

        if (media instanceof HTMLElement) {
          const safeName = escapeHtml(currentProduct.name);
          media.innerHTML = image
            ? `<img src="${escapeHtml(image.src)}" alt="${escapeHtml(image.alt || currentProduct.name)}">`
            : `<span>${safeName.slice(0, 1).toUpperCase()}</span>`;
        }
        if (name) {
          name.textContent = currentProduct.name;
        }
        if (price) {
          price.textContent = currentPrice;
        }
        if (description instanceof HTMLElement) {
          description.textContent = stripHtml(currentProduct.description || currentProduct.short_description || '');
        }
        if (status instanceof HTMLElement) {
          status.hidden = true;
        }
        if (skeleton instanceof HTMLElement) {
          skeleton.hidden = true;
        }
        if (detail instanceof HTMLElement) {
          detail.hidden = false;
        }
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'No se pudo cargar el producto.', 'error');
      }
    };

    addButton?.addEventListener('click', async () => {
      if (!currentProduct) {
        return;
      }

      addButton.disabled = true;

      try {
        await addCartItem({
          id: currentProduct.id,
          slug: currentProduct.slug,
          name: currentProduct.name,
          price: currentPrice,
          image: currentProduct.images?.[0]?.src,
          quantity: 1,
        });

        addButton.textContent = 'Anadido al carrito';
      } catch (error) {
        addButton.textContent = error instanceof Error ? error.message : 'No se pudo anadir';
      } finally {
        window.setTimeout(() => {
          addButton.disabled = false;
          addButton.textContent = 'Añadir al carrito';
        }, 1400);
      }
    });

    loadProduct();
  </script>
</BaseLayout>

<style>
  .product-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .product-detail {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
  }

  .product-skeleton {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
  }

  .product-skeleton[hidden] {
    display: none;
  }

  .skeleton-media,
  .skeleton-summary {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
  }

  .skeleton-media {
    aspect-ratio: 1;
    background: linear-gradient(90deg, var(--color-surface-strong), #f9fafb, var(--color-surface-strong));
    background-size: 200% 100%;
    animation: product-skeleton-pulse 1.2s ease-in-out infinite;
  }

  .skeleton-summary {
    display: grid;
    gap: 14px;
    padding: 28px;
  }

  .skeleton-summary span {
    display: block;
    height: 14px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-surface-strong), #f9fafb, var(--color-surface-strong));
    background-size: 200% 100%;
    animation: product-skeleton-pulse 1.2s ease-in-out infinite;
  }

  .skeleton-eyebrow {
    width: 92px;
    height: 11px !important;
  }

  .skeleton-title {
    width: min(460px, 100%);
    height: clamp(36px, 6vw, 62px) !important;
    margin-bottom: 4px;
  }

  .skeleton-price {
    width: 130px;
    height: 22px !important;
    margin: 4px 0 10px;
  }

  .skeleton-summary span:nth-child(4) {
    width: 92%;
  }

  .skeleton-summary span:nth-child(5) {
    width: 84%;
  }

  .skeleton-short {
    width: 54%;
  }

  .skeleton-button {
    width: 180px;
    height: 44px !important;
    margin-top: 12px;
    border-radius: var(--radius-pill) !important;
  }

  @keyframes product-skeleton-pulse {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .media {
    display: grid;
    overflow: hidden;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media span {
    color: var(--color-primary);
    font-size: 5rem;
    font-weight: 800;
  }

  .summary,
  .notice {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 28px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
  }

  .price {
    margin: 18px 0;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .description {
    color: var(--color-body);
    line-height: 1.7;
  }

  .notice[data-state="error"] {
    color: var(--color-danger);
  }

  [hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .product-detail,
    .product-skeleton {
      grid-template-columns: 1fr;
    }
  }
</style>
