---
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';

const wpAdminUrl = siteConfig.apiUrl.replace(/\/wp-json\/?$/, '/wp/wp-admin/');
---

<BaseLayout title={`Admin | ${siteConfig.name}`}>
  <SiteHeader active="perfil" />

  <main class="admin-view">
    <section class="page-shell admin-shell">
      <div>
        <p class="eyebrow">Backoffice web</p>
        <h1>Administracion</h1>
        <p class="lede">Lanzadera segura para administradores. La edicion pesada sigue viviendo en WordPress; Astro puede mostrar lecturas o accesos rapidos.</p>
      </div>

      <section class="admin-panel" id="admin-panel" data-state="loading">
        <p id="admin-status">Comprobando permisos...</p>
        <div class="pending-panel" id="pending-panel" hidden>
          <article><span>Pedidos en espera</span><strong id="pending-orders">-</strong></article>
          <article><span>Bajo stock</span><strong id="pending-low-stock">-</strong></article>
          <article><span>Sin stock</span><strong id="pending-out-stock">-</strong></article>
        </div>
        <div class="admin-grid" id="admin-grid" hidden>
          <a class="admin-only" href={`${wpAdminUrl}`}>WordPress admin</a>
          <a class="admin-only" href="/usuarios">Listado de usuarios</a>
          <a href="/inventario">Inventario frontend</a>
          <a href="/ventas">Ventas frontend</a>
          <a href={`${wpAdminUrl}edit.php?post_type=product`}>Productos en WordPress</a>
          <a href={`${wpAdminUrl}admin.php?page=wc-orders`}>Pedidos en WordPress</a>
          <a href={`${wpAdminUrl}admin.php?page=wc-settings`}>Ajustes WooCommerce</a>
          <a class="admin-only" href={`${wpAdminUrl}edit.php?post_type=acf-field-group`}>Campos ACF</a>
          <a class="admin-only" href="/admin/estado">Estado del sistema</a>
        </div>
      </section>
    </section>
  </main>

  <script define:vars={{ meUrl: tcgApi.me, salesUrl: tcgApi.adminSales, inventoryUrl: tcgApi.adminInventory }}>
    const panel = document.querySelector('#admin-panel');
    const status = document.querySelector('#admin-status');
    const grid = document.querySelector('#admin-grid');
    const pendingPanel = document.querySelector('#pending-panel');
    const pendingOrders = document.querySelector('#pending-orders');
    const pendingLowStock = document.querySelector('#pending-low-stock');
    const pendingOutStock = document.querySelector('#pending-out-stock');

    const loadPending = async () => {
      try {
        const [salesResponse, inventoryResponse] = await Promise.all([
          fetch(salesUrl, { credentials: 'include' }),
          fetch(`${inventoryUrl}?per_page=5`, { credentials: 'include' }),
        ]);
        const sales = await salesResponse.json();
        const inventory = await inventoryResponse.json();
        if (pendingOrders) pendingOrders.textContent = String(sales.data?.metrics?.pending ?? 0);
        if (pendingLowStock) pendingLowStock.textContent = String(inventory.alerts?.low_stock?.length ?? 0);
        if (pendingOutStock) pendingOutStock.textContent = String(inventory.alerts?.out_of_stock?.length ?? 0);
        if (pendingPanel) pendingPanel.hidden = false;
      } catch {}
    };

    fetch(meUrl, { credentials: 'include' })
      .then(async (response) => {
        if (!response.ok) throw new Error('Debes iniciar sesion.');
        const payload = await response.json();
        if (!payload.data?.can_access_backoffice) throw new Error('Tu usuario no tiene permisos de administracion.');
        panel.dataset.state = 'ready';
        status.textContent = payload.data?.is_admin
          ? 'Accesos disponibles para administracion.'
          : 'Accesos disponibles para gestion de tienda.';
        grid.hidden = false;
        if (!payload.data?.is_admin) {
          grid.querySelectorAll('.admin-only').forEach((item) => { item.hidden = true; });
        }
        loadPending();
      })
      .catch((error) => {
        panel.dataset.state = 'error';
        status.textContent = error.message;
      });
  </script>
</BaseLayout>

<style>
  .admin-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .admin-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 40px;
    align-items: start;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  #admin-status {
    color: var(--color-body);
    line-height: 1.7;
  }

  .admin-panel {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .admin-panel[data-state="error"] {
    border-color: color-mix(in srgb, var(--color-danger), var(--color-hairline) 70%);
  }

  .admin-grid {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .pending-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .pending-panel article {
    display: grid;
    gap: 5px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-surface-soft);
    padding: 12px;
  }

  .pending-panel span {
    color: var(--color-body);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .pending-panel strong {
    font-size: 1.45rem;
  }

  .admin-grid a {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    padding: 14px;
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .admin-shell,
    .pending-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
