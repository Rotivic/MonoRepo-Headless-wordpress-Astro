---
import BackButton from '../components/BackButton.astro';
import ModuleDisabled from '../components/ModuleDisabled.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Pagination from '../components/Pagination.astro';
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Ventas | ${siteConfig.name}`}>
  <SiteHeader active="tienda" />

  {
    siteConfig.features.shop ? (
      <main class="sales-view">
        <section class="page-shell sales-shell" id="sales-loading">
          <div>
            <BackButton fallback="/admin" />
            <p class="eyebrow">Ventas</p>
            <h1>Panel de ventas</h1>
            <p class="lede">Validando permisos...</p>
          </div>
          <section class="sales-panel sales-skeleton">
            <div class="metric"><span></span><strong></strong></div>
            <div class="metric"><span></span><strong></strong></div>
            <div class="metric"><span></span><strong></strong></div>
            <div class="chart-card"><span></span><span></span></div>
          </section>
        </section>
        <section class="page-shell sales-shell" id="backoffice-page" hidden>
          <div>
            <BackButton fallback="/admin" />
            <p class="eyebrow">Ventas</p>
            <h1>Panel de ventas</h1>
            <p class="lede">Resumen de pedidos WooCommerce para administradores y gestores de tienda.</p>
          </div>

          <section class="sales-panel">
            <div class="metric">
              <span>Pedidos</span>
              <strong id="metric-orders">-</strong>
            </div>
            <div class="metric">
              <span>Ingresos</span>
              <strong id="metric-revenue">-</strong>
            </div>
            <div class="metric">
              <span>Pendientes</span>
              <strong id="metric-pending">-</strong>
            </div>
            <div class="chart-card">
              <div class="chart-head">
                <h2>Ventas reales</h2>
                <span id="sales-range-label">Rango seleccionado</span>
              </div>
              <form class="date-range" id="sales-range">
                <input id="date-from" type="date" />
                <input id="date-to" type="date" />
                <button class="button button-secondary" type="submit">Aplicar</button>
                <button class="button button-secondary" id="export-csv" type="button">Export CSV</button>
              </form>
              <div class="chart" id="sales-chart" aria-label="Grafica de ventas semanales"></div>
            </div>
            <div class="orders-table-card">
              <div class="chart-head">
                <h2>Pedidos</h2>
                <span id="orders-count">0 resultados</span>
              </div>
              <form class="orders-search" id="orders-search">
                <input id="orders-query" type="search" placeholder="Buscar por pedido, cliente, email, estado o total" autocomplete="off" />
              </form>
              <div class="orders-table" id="orders-table"></div>
              <Pagination id="sales-pagination" label="Paginacion de ventas" />
            </div>
            <p class="notice" id="sales-status"></p>
          </section>
        </section>
        <div class="sales-modal-backdrop" id="sales-modal-backdrop" hidden></div>
        <dialog class="sales-modal" id="sales-modal">
          <div class="modal-head">
            <div>
              <p class="eyebrow">Detalle</p>
              <h2 id="modal-title">Pedido</h2>
            </div>
            <button class="button button-secondary" id="modal-close" type="button">Cerrar</button>
          </div>
          <div class="modal-body" id="modal-body"></div>
        </dialog>
      </main>
    ) : (
      <ModuleDisabled
        title="Ventas desactivadas"
        summary="Ventas forma parte del modulo tienda. Puedes ocultarlo con PUBLIC_ENABLE_SHOP=false."
      />
    )
  }

  <script define:vars={{ meUrl: tcgApi.me, salesUrl: tcgApi.adminSales }}>
    const page = document.querySelector('#backoffice-page');
    const loading = document.querySelector('#sales-loading');
    const metricOrders = document.querySelector('#metric-orders');
    const metricRevenue = document.querySelector('#metric-revenue');
    const metricPending = document.querySelector('#metric-pending');
    const chart = document.querySelector('#sales-chart');
    const ordersTable = document.querySelector('#orders-table');
    const ordersSearch = document.querySelector('#orders-search');
    const ordersQuery = document.querySelector('#orders-query');
    const ordersCount = document.querySelector('#orders-count');
    const pagination = document.querySelector('#sales-pagination');
    const salesStatus = document.querySelector('#sales-status');
    const modal = document.querySelector('#sales-modal');
    const modalBackdrop = document.querySelector('#sales-modal-backdrop');
    const modalTitle = document.querySelector('#modal-title');
    const modalBody = document.querySelector('#modal-body');
    const modalClose = document.querySelector('#modal-close');
    const rangeForm = document.querySelector('#sales-range');
    const dateFrom = document.querySelector('#date-from');
    const dateTo = document.querySelector('#date-to');
    const exportCsv = document.querySelector('#export-csv');
    const rangeLabel = document.querySelector('#sales-range-label');
    let allOrders = [];
    let filteredOrders = [];
    let currentPage = 1;
    const perPage = 8;

    const isoDate = (date) => date.toISOString().slice(0, 10);
    const today = new Date();
    const previous = new Date();
    previous.setDate(today.getDate() - 29);
    if (dateFrom) dateFrom.value = isoDate(previous);
    if (dateTo) dateTo.value = isoDate(today);

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const renderSales = (data) => {
      if (metricOrders) metricOrders.textContent = String(data.metrics?.orders ?? 0);
      if (metricRevenue) metricRevenue.textContent = data.metrics?.revenue || '0';
      if (metricPending) metricPending.textContent = String(data.metrics?.pending ?? 0);

      const max = Math.max(1, ...(data.chart || []).map((item) => Number(item.total || 0)));
      if (chart) {
        const marks = [100, 75, 50, 25, 0];
        chart.innerHTML = `
          <div class="chart-scale">
            ${marks.map((mark) => `<span>${Math.round((max * mark) / 100)}</span>`).join('')}
          </div>
          <div class="chart-bars" style="--days: ${(data.chart || []).length || 30}">
            ${(data.chart || []).map((item, index, items) => {
          const value = Math.max(8, Math.round((Number(item.total || 0) / max) * 100));
              const showLabel = index === 0 || index === items.length - 1 || index % 5 === 0;
              return `<span style="--value: ${value}" data-label="${showLabel ? escapeHtml(item.label) : ''}" title="${escapeHtml(item.label)} · ${Number(item.total || 0).toFixed(2)}"></span>`;
            }).join('')}
          </div>
        `;
      }

      allOrders = data.orders || [];
      filteredOrders = allOrders;
      if (rangeLabel) rangeLabel.textContent = `${data.range?.from || dateFrom?.value || ''} - ${data.range?.to || dateTo?.value || ''}`;
      renderOrdersTable();
    };

    const orderSearchText = (order) => [
      order.number,
      order.id,
      order.status_label,
      order.status,
      order.total,
      order.billing?.name,
      order.billing?.email,
      order.payment_method_title,
    ].join(' ').toLowerCase();

    const renderOrdersTable = () => {
      if (!ordersTable) return;
      const totalPages = Math.max(1, Math.ceil(filteredOrders.length / perPage));
      currentPage = Math.min(currentPage, totalPages);
      const visible = filteredOrders.slice((currentPage - 1) * perPage, currentPage * perPage);

      if (ordersCount) ordersCount.textContent = `${filteredOrders.length} resultado${filteredOrders.length === 1 ? '' : 's'}`;
      if (pagination) pagination.hidden = filteredOrders.length <= perPage;
      pagination?.querySelector('[data-pagination-status]') && (pagination.querySelector('[data-pagination-status]').textContent = `Pagina ${currentPage} de ${totalPages}`);
      pagination?.querySelector('[data-pagination-prev]') && (pagination.querySelector('[data-pagination-prev]').disabled = currentPage <= 1);
      pagination?.querySelector('[data-pagination-next]') && (pagination.querySelector('[data-pagination-next]').disabled = currentPage >= totalPages);

      ordersTable.innerHTML = `
        <div class="orders-row orders-row-head">
          <span>Pedido</span>
          <span>Cliente</span>
          <span>Estado</span>
          <span>Total</span>
          <span></span>
        </div>
        ${visible.map((order) => `
          <article class="orders-row">
            <div>
              <strong>#${escapeHtml(order.number || order.id)}</strong>
              <span>${order.created_at ? new Date(order.created_at).toLocaleString('es-ES') : ''}</span>
            </div>
            <div>
              <strong>${escapeHtml(order.billing?.name || 'Cliente')}</strong>
              <span>${escapeHtml(order.billing?.email || '')}</span>
            </div>
            <span class="status-pill">${escapeHtml(order.status_label || order.status || '')}</span>
            <strong>${escapeHtml(order.total || '')}</strong>
            <div class="row-actions">
              <button class="button button-secondary order-detail" type="button" data-id="${Number(order.id)}">Ver</button>
              ${order.edit_url ? `<a class="button button-secondary" href="${escapeHtml(order.edit_url)}" target="_blank" rel="noreferrer">WP</a>` : ''}
            </div>
          </article>
        `).join('') || '<p class="notice">No hay pedidos para mostrar.</p>'}
      `;

      ordersTable.querySelectorAll('.order-detail').forEach((button) => {
        button.addEventListener('click', () => openOrderModal(Number(button.dataset.id)));
      });
    };

    const openOrderModal = (orderId) => {
      const order = allOrders.find((item) => Number(item.id) === orderId);
      if (!order || !modal || !modalBody || !modalTitle) return;
      modalTitle.textContent = `Pedido #${order.number || order.id}`;
      modalBody.innerHTML = `
        <dl class="modal-data">
          <div><dt>Estado</dt><dd>${escapeHtml(order.status_label || order.status || '')}</dd></div>
          <div><dt>Total</dt><dd>${escapeHtml(order.total || '')}</dd></div>
          <div><dt>Fecha</dt><dd>${order.created_at ? new Date(order.created_at).toLocaleString('es-ES') : ''}</dd></div>
          <div><dt>Pago</dt><dd>${escapeHtml(order.payment_method_title || '')}</dd></div>
          <div><dt>Cliente</dt><dd>${escapeHtml(order.billing?.name || '')}</dd></div>
          <div><dt>Email</dt><dd>${escapeHtml(order.billing?.email || '')}</dd></div>
          <div><dt>Direccion</dt><dd>${escapeHtml(order.billing?.address || '')}</dd></div>
          <div><dt>Accion</dt><dd>${order.edit_url ? `<a href="${escapeHtml(order.edit_url)}" target="_blank" rel="noreferrer">Editar pedido en WordPress</a>` : ''}</dd></div>
        </dl>
        <div class="modal-items">
          ${(order.items || []).map((item) => `
            <article>
              <strong>${escapeHtml(item.name)}</strong>
              <span>${Number(item.quantity || 1)} x ${escapeHtml(item.total || '')}</span>
            </article>
          `).join('')}
        </div>
      `;
      modalBackdrop.hidden = false;
      modal.showModal();
    };

    const closeModal = () => {
      modal?.close();
      if (modalBackdrop) modalBackdrop.hidden = true;
    };

    ordersSearch?.addEventListener('submit', (event) => event.preventDefault());
    ordersQuery?.addEventListener('input', () => {
      const query = ordersQuery.value.trim().toLowerCase();
      filteredOrders = query ? allOrders.filter((order) => orderSearchText(order).includes(query)) : allOrders;
      currentPage = 1;
      renderOrdersTable();
    });

    pagination?.querySelector('[data-pagination-prev]')?.addEventListener('click', () => {
      currentPage = Math.max(1, currentPage - 1);
      renderOrdersTable();
    });

    pagination?.querySelector('[data-pagination-next]')?.addEventListener('click', () => {
      currentPage += 1;
      renderOrdersTable();
    });

    modalClose?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);
    modal?.addEventListener('close', () => {
      if (modalBackdrop) modalBackdrop.hidden = true;
    });

    const buildSalesUrl = () => {
      const url = new URL(salesUrl);
      if (dateFrom?.value) url.searchParams.set('date_from', dateFrom.value);
      if (dateTo?.value) url.searchParams.set('date_to', dateTo.value);
      return url;
    };

    const loadSales = async () => {
      const salesResponse = await fetch(buildSalesUrl(), { credentials: 'include' });
      const salesPayload = await salesResponse.json();
      if (!salesResponse.ok) throw new Error(salesPayload.message || 'No se pudieron cargar las ventas.');
      renderSales(salesPayload.data || {});
    };

    const csvEscape = (value) => `"${String(value ?? '').replace(/"/g, '""')}"`;
    const downloadCsv = () => {
      const rows = [
        ['Pedido', 'Fecha', 'Cliente', 'Email', 'Estado', 'Total', 'Pago'],
        ...filteredOrders.map((order) => [
          order.number || order.id,
          order.created_at ? new Date(order.created_at).toLocaleString('es-ES') : '',
          order.billing?.name || '',
          order.billing?.email || '',
          order.status_label || order.status || '',
          order.total || '',
          order.payment_method_title || '',
        ]),
      ];
      const csv = rows.map((row) => row.map(csvEscape).join(',')).join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `ventas-${dateFrom?.value || 'inicio'}-${dateTo?.value || 'hoy'}.csv`;
      link.click();
      URL.revokeObjectURL(url);
    };

    rangeForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        if (salesStatus) salesStatus.textContent = 'Cargando ventas...';
        await loadSales();
        if (salesStatus) salesStatus.textContent = '';
      } catch (error) {
        if (salesStatus) salesStatus.textContent = error instanceof Error ? error.message : 'No se pudieron cargar las ventas.';
      }
    });

    exportCsv?.addEventListener('click', downloadCsv);

    fetch(meUrl, { credentials: 'include' })
      .then(async (response) => {
        if (!response.ok) throw new Error('Debes iniciar sesion.');
        const payload = await response.json();
        if (!payload.data?.can_access_backoffice) throw new Error('Sin permisos.');
        await loadSales();
        if (loading) loading.hidden = true;
        if (page) page.hidden = false;
      })
      .catch(() => {
        window.location.assign('/login');
      });
  </script>
</BaseLayout>

<style>
  .sales-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .sales-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    gap: 40px;
    align-items: start;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede,
  .metric span,
  .notice {
    color: var(--color-body);
    line-height: 1.7;
  }

  .sales-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  #sales-loading[hidden],
  #backoffice-page[hidden] {
    display: none;
  }

  .sales-skeleton span,
  .sales-skeleton strong {
    display: block;
    min-height: 14px;
    border-radius: 999px;
    background: var(--color-surface-strong);
  }

  .sales-skeleton .metric strong {
    width: 64%;
    min-height: 22px;
  }

  .sales-skeleton .chart-card span:first-child {
    width: 34%;
    min-height: 16px;
  }

  .sales-skeleton .chart-card span:last-child {
    min-height: 120px;
    border-radius: var(--radius-item);
    background: linear-gradient(90deg, var(--color-surface-strong), #f9fafb, var(--color-surface-strong));
    background-size: 200% 100%;
    animation: sales-skeleton-pulse 1.2s ease-in-out infinite;
  }

  @keyframes sales-skeleton-pulse {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .metric {
    display: grid;
    gap: 8px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    padding: 14px;
  }

  .metric strong {
    font-size: 1.35rem;
  }

  .chart-card {
    display: grid;
    grid-column: 1 / -1;
    gap: 18px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: linear-gradient(180deg, var(--color-canvas), var(--color-surface-soft));
    padding: 18px;
  }

  .orders-table-card {
    display: grid;
    grid-column: 1 / -1;
    gap: 12px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    padding: 18px;
  }

  .orders-search input {
    width: 100%;
  }

  .orders-table {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-hairline);
  }

  :global(.orders-row) {
    display: grid;
    grid-template-columns: 1fr 1.1fr auto auto auto;
    gap: 14px;
    align-items: center;
    background: var(--color-canvas);
    padding: 12px;
  }

  :global(.orders-row-head) {
    background: var(--color-surface-soft);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  :global(.orders-row div) {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  :global(.orders-row span) {
    color: var(--color-body);
    font-size: 0.88rem;
    font-weight: 700;
  }

  :global(.status-pill) {
    border-radius: var(--radius-pill);
    background: var(--color-surface-strong);
    padding: 7px 10px;
    white-space: nowrap;
  }

  :global(.row-actions) {
    display: inline-flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .chart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .chart-head h2 {
    margin: 0;
    font-size: 1.05rem;
  }

  .chart-head span {
    color: var(--color-body);
    font-size: 0.9rem;
  }

  .chart {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    height: 220px;
    padding-top: 8px;
  }

  .date-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) auto auto;
    gap: 10px;
  }

  .date-range input {
    width: 100%;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-input);
    background: var(--color-canvas);
    padding: 10px 12px;
    font: inherit;
  }

  :global(.chart-scale) {
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    align-items: center;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 800;
    text-align: right;
  }

  :global(.chart-bars) {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--days, 30), minmax(4px, 1fr));
    gap: 4px;
    align-items: end;
    border-bottom: 1px solid var(--color-hairline);
    background:
      linear-gradient(to bottom, transparent calc(25% - 1px), var(--color-hairline) 25%, transparent calc(25% + 1px)),
      linear-gradient(to bottom, transparent calc(50% - 1px), var(--color-hairline) 50%, transparent calc(50% + 1px)),
      linear-gradient(to bottom, transparent calc(75% - 1px), var(--color-hairline) 75%, transparent calc(75% + 1px));
    padding-top: 6px;
  }

  :global(.chart-bars > span) {
    position: relative;
    display: block;
    min-height: 8px;
    height: calc(var(--value) * 1%);
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--color-primary), #05b169);
  }

  :global(.chart-bars > span::after) {
    content: attr(data-label);
    position: absolute;
    bottom: -24px;
    left: 50%;
    color: var(--color-body);
    font-size: 0.68rem;
    font-weight: 800;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .notice {
    grid-column: 1 / -1;
    margin: 8px 0 0;
  }

  .sales-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 39;
    background: rgba(0, 0, 0, 0.35);
  }

  .sales-modal-backdrop[hidden] {
    display: none;
  }

  .sales-modal {
    width: min(720px, calc(100vw - 32px));
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 0;
  }

  .sales-modal::backdrop {
    background: transparent;
  }

  .modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--color-hairline);
    padding: 18px;
  }

  .modal-head h2 {
    margin: 0;
  }

  .modal-body {
    display: grid;
    gap: 16px;
    padding: 18px;
  }

  :global(.modal-data) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-hairline);
  }

  :global(.modal-data div) {
    background: var(--color-canvas);
    padding: 12px;
  }

  :global(.modal-data dt) {
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  :global(.modal-data dd) {
    margin: 4px 0 0;
    overflow-wrap: anywhere;
    font-weight: 700;
  }

  :global(.modal-items) {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-hairline);
  }

  :global(.modal-items article) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    background: var(--color-canvas);
    padding: 12px;
  }

  @media (max-width: 860px) {
    .sales-shell,
    .sales-panel,
    .date-range {
      grid-template-columns: 1fr;
    }

    :global(.orders-row),
    :global(.modal-data) {
      grid-template-columns: 1fr;
    }
  }
</style>
