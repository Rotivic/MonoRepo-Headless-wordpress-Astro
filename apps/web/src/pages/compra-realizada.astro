---
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';
import BaseLayout from '../layouts/BaseLayout.astro';

const wpAdminUrl = siteConfig.apiUrl.replace(/\/wp-json\/?$/, '/wp/wp-admin/');
---

<BaseLayout title={`Compra realizada | ${siteConfig.name}`}>
  <SiteHeader active="carrito" />

  <main class="success-view">
    <section class="page-shell success-shell">
      <div>
        <p class="eyebrow">Pedido creado</p>
        <h1>Compra realizada</h1>
        <p class="lede">Pedido real creado en WooCommerce mediante el checkout local de pruebas.</p>
        <div class="actions">
          <a class="button button-primary" href="/mis-pedidos">Ver mis pedidos</a>
          <a class="button button-secondary" href="/tienda">Seguir comprando</a>
        </div>
      </div>

      <section class="success-panel">
        <h2>Resumen</h2>
        <p id="order-id" class="order-id">Pedido</p>
        <p id="order-status" class="order-status"></p>
        <div id="order-items" class="items"></div>
        <p id="order-total" class="order-total"></p>
        <a class="button button-secondary wp-order-link" id="wp-order-link" href="#" hidden>Ver pedido en WordPress</a>
      </section>
    </section>
  </main>

  <script define:vars={{ meUrl: tcgApi.me, wpAdminUrl }}>
    const orderKey = 'tcg.last-checkout-order';
    const idRoot = document.querySelector('#order-id');
    const statusRoot = document.querySelector('#order-status');
    const itemsRoot = document.querySelector('#order-items');
    const totalRoot = document.querySelector('#order-total');
    const wpOrderLink = document.querySelector('#wp-order-link');

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    try {
      const order = JSON.parse(localStorage.getItem(orderKey) || 'null');
      if (order && idRoot && itemsRoot) {
        idRoot.textContent = `Pedido #${order.number || order.id}`;
        if (statusRoot) statusRoot.textContent = `Estado: ${order.status || 'creado'} · Pago: ${order.payment_method_title || 'Local test checkout'}`;
        if (totalRoot) totalRoot.textContent = order.total ? `Total ${order.total}` : '';
        if (wpOrderLink && order.id) {
          wpOrderLink.href = `${wpAdminUrl}admin.php?page=wc-orders&action=edit&id=${encodeURIComponent(order.id)}`;
        }
        itemsRoot.innerHTML = (order.items || []).map((item) => `
          <article class="order-line">
            <strong>${escapeHtml(item.name)}</strong>
            <span>${escapeHtml(item.total || item.subtotal || '')} x ${Number(item.quantity || 1)}</span>
          </article>
        `).join('');
      }
    } catch {}

    if (wpOrderLink) {
      fetch(meUrl, { credentials: 'include' })
        .then(async (response) => {
          if (!response.ok) return;
          const payload = await response.json();
          wpOrderLink.hidden = !payload.data?.can_access_backoffice || !wpOrderLink.getAttribute('href') || wpOrderLink.getAttribute('href') === '#';
        })
        .catch(() => {});
    }
  </script>
</BaseLayout>

<style>
  .success-view {
    min-height: calc(100vh - 65px);
    padding: 56px 0;
    background: var(--color-surface-soft);
  }

  .success-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: 40px;
    align-items: start;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-success);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .lede {
    color: var(--color-body);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .success-panel {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
    padding: 22px;
  }

  .order-id,
  .order-status,
  .order-total {
    color: var(--color-body);
    font-weight: 800;
  }

  .order-status {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .wp-order-link {
    margin-top: 14px;
  }

  :global(.order-line) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--color-hairline);
    padding: 12px 0;
  }

  @media (max-width: 860px) {
    .success-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
