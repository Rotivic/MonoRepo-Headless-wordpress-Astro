---
import { formatStorePrice, type StoreProduct } from '../lib/shop';

interface Props {
  product: StoreProduct;
}

const { product } = Astro.props;
const image = product.images?.[0];
const price = formatStorePrice(product.prices);
const summary = (product.short_description || product.description || 'Producto preparado para el catalogo.')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
---

<article class="product-card">
  <a class="media" href={`/producto?slug=${product.slug}`} aria-label={`Ver ${product.name}`}>
    {
      image ? (
        <img src={image.src} alt={image.alt || product.name} loading="lazy" />
      ) : (
        <span>{product.name.slice(0, 1).toUpperCase()}</span>
      )
    }
  </a>

  <div class="body">
    <div>
      <h2><a href={`/producto?slug=${product.slug}`}>{product.name}</a></h2>
      <p>{summary}</p>
    </div>

    <div class="actions">
      <strong>{price}</strong>
      <button
        class="button button-secondary add-to-cart"
        type="button"
        data-id={product.id}
        data-slug={product.slug}
        data-name={product.name}
        data-price={price}
        data-image={image?.src ?? ''}
      >
        Añadir
      </button>
      <button
        class="wishlist-toggle add-to-wishlist"
        type="button"
        aria-label={`Guardar ${product.name} en wishlist`}
        aria-pressed="false"
        data-id={product.id}
        data-slug={product.slug}
        data-name={product.name}
        data-price={price}
        data-image={image?.src ?? ''}
      >
        <svg class="heart-empty" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6Z" />
        </svg>
        <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.2 4.1 13.4A5.55 5.55 0 0 1 12 5.6a5.55 5.55 0 0 1 7.9 7.8L12 21.2Z" />
        </svg>
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
  }

  .media {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    background: var(--color-surface-strong);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media span {
    color: var(--color-primary);
    font-size: 3rem;
    font-weight: 800;
  }

  .body {
    display: grid;
    gap: 20px;
    padding: 18px;
  }

  h2 {
    margin: 0;
    font-size: 1.12rem;
  }

  p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    min-height: 48px;
    margin: 8px 0 0;
    color: var(--color-body);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
  }

  strong {
    font-size: 1rem;
  }

  .wishlist-toggle {
    appearance: none;
    display: inline-grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    background: var(--color-canvas);
    color: var(--color-body);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .wishlist-toggle:hover {
    border-color: #f2b8c0;
    background: #fff5f6;
    color: var(--color-danger);
    transform: translateY(-1px);
  }

  .wishlist-toggle[aria-pressed="true"] {
    border-color: #f2b8c0;
    background: #fff5f6;
    color: var(--color-danger);
  }

  .wishlist-toggle.is-active {
    border-color: #f2b8c0;
    background: #fff5f6;
    color: var(--color-danger);
  }

  .wishlist-toggle .heart-filled,
  .wishlist-toggle[aria-pressed="true"] .heart-empty,
  .wishlist-toggle.is-active .heart-empty {
    display: none;
  }

  .wishlist-toggle[aria-pressed="true"] .heart-filled,
  .wishlist-toggle.is-active .heart-filled {
    display: block;
  }

  .wishlist-toggle:disabled {
    cursor: wait;
    opacity: 0.7;
    transform: none;
  }

  :global(.product-card .wishlist-toggle) {
    appearance: none;
    display: inline-grid;
    width: 38px;
    height: 38px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    background: var(--color-canvas);
    color: var(--color-body);
  }

  :global(.product-card .wishlist-toggle:hover),
  :global(.product-card .wishlist-toggle[aria-pressed="true"]),
  :global(.product-card .wishlist-toggle.is-active) {
    border-color: #f2b8c0;
    background: #fff5f6;
    color: var(--color-danger);
  }

  :global(.product-card .wishlist-toggle .heart-filled),
  :global(.product-card .wishlist-toggle[aria-pressed="true"] .heart-empty),
  :global(.product-card .wishlist-toggle.is-active .heart-empty) {
    display: none;
  }

  :global(.product-card .wishlist-toggle[aria-pressed="true"] .heart-filled),
  :global(.product-card .wishlist-toggle.is-active .heart-filled) {
    display: block;
  }
</style>
