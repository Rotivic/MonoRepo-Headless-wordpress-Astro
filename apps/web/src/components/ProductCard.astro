---
import { formatStorePrice, type StoreProduct } from '../lib/shop';

interface Props {
  product: StoreProduct;
}

const { product } = Astro.props;
const image = product.images?.[0];
const price = formatStorePrice(product.prices);
const summary = (product.short_description || product.description || 'Producto preparado para el catalogo.')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
---

<article class="product-card">
  <a class="media" href={`/producto?slug=${product.slug}`} aria-label={`Ver ${product.name}`}>
    {
      image ? (
        <img src={image.src} alt={image.alt || product.name} loading="lazy" />
      ) : (
        <span>{product.name.slice(0, 1).toUpperCase()}</span>
      )
    }
  </a>

  <div class="body">
    <div>
      <h2><a href={`/producto?slug=${product.slug}`}>{product.name}</a></h2>
      <p>{summary}</p>
    </div>

    <div class="actions">
      <strong>{price}</strong>
      <button
        class="button button-secondary add-to-cart"
        type="button"
        data-id={product.id}
        data-slug={product.slug}
        data-name={product.name}
        data-price={price}
        data-image={image?.src ?? ''}
      >
        Añadir
      </button>
      <button
        class="button button-text add-to-wishlist"
        type="button"
        data-id={product.id}
        data-slug={product.slug}
        data-name={product.name}
        data-price={price}
        data-image={image?.src ?? ''}
      >
        Wishlist
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-item);
    background: var(--color-canvas);
  }

  .media {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    background: var(--color-surface-strong);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media span {
    color: var(--color-primary);
    font-size: 3rem;
    font-weight: 800;
  }

  .body {
    display: grid;
    gap: 20px;
    padding: 18px;
  }

  h2 {
    margin: 0;
    font-size: 1.12rem;
  }

  p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    min-height: 48px;
    margin: 8px 0 0;
    color: var(--color-body);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
  }

  strong {
    font-size: 1rem;
  }
</style>
