---
interface Props {
  id: string;
  label?: string;
}

const { id, label = 'Paginacion' } = Astro.props;
---

<nav class="pagination" id={id} aria-label={label} hidden>
  <button class="button button-secondary" type="button" data-pagination-prev>Anterior</button>
  <span data-pagination-status>Pagina 1 de 1</span>
  <button class="button button-secondary" type="button" data-pagination-next>Siguiente</button>
</nav>

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
  }

  .pagination[hidden] {
    display: none;
  }

  .pagination span {
    color: var(--color-body);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .pagination button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (max-width: 640px) {
    .pagination {
      justify-content: stretch;
    }

    .pagination button,
    .pagination span {
      width: 100%;
      text-align: center;
    }
  }
</style>
