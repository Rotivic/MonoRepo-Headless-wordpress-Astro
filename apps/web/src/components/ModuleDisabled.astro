---
interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<section class="page-shell disabled-module">
  <p class="eyebrow">Modulo opcional</p>
  <h1>{title}</h1>
  <p>{summary}</p>
</section>

<style>
  .disabled-module {
    min-height: calc(100vh - 65px);
    display: grid;
    align-content: center;
    gap: 14px;
    padding: 56px 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1;
  }

  p {
    max-width: 620px;
    margin: 0;
    color: var(--color-body);
    line-height: 1.7;
  }
</style>
