---
interface Props {
  index: number;
  title: string;
  summary: string;
}

const { index, title, summary } = Astro.props;
---

<article>
  <span>{String(index).padStart(2, '0')}</span>
  <h2>{title}</h2>
  <p>{summary}</p>
</article>

<style>
  article {
    min-height: 150px;
    border: 1px solid rgba(23, 32, 38, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 18px 60px rgba(32, 40, 44, 0.08);
    padding: 20px;
  }

  span {
    color: #b84235;
    font-weight: 800;
  }

  h2 {
    margin: 28px 0 10px;
    font-size: 1.35rem;
  }

  p {
    margin: 0;
    color: #526168;
    line-height: 1.55;
  }
</style>
