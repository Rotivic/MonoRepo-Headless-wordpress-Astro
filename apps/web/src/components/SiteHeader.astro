---
import { siteConfig } from '../config/site';
import { tcgApi } from '../lib/tcg-api';

interface Props {
  active?: 'home' | 'login' | 'registro' | 'perfil' | 'tienda' | 'carrito';
}

const { active = 'home' } = Astro.props;
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-mark">T</span>
      <span>{siteConfig.name}</span>
    </a>

    <nav class="nav-links" aria-label="Navegacion principal">
      <a class:list={[{ active: active === 'home' }]} href="/">Inicio</a>
      {siteConfig.features.shop && (
        <a class:list={[{ active: active === 'tienda' }]} href="/tienda">Tienda</a>
      )}
    </nav>

    <div class="nav-actions" data-auth-state="loading">
      <!-- Guest -->
      <a class:list={['button', 'button-secondary', 'session-guest', { active: active === 'login' }]} href="/login" hidden>
        Entrar
      </a>
      <a class:list={['button', 'button-primary', 'session-guest', { active: active === 'registro' }]} href="/registro" hidden>
        Crear cuenta
      </a>

      <!-- User: avatar dropdown -->
      <div class="user-menu session-user" id="user-menu" hidden>
        <button class="user-trigger" id="user-trigger" type="button" aria-label="Menu de usuario" aria-expanded="false" aria-haspopup="true" style="display:flex;align-items:center;border:none;background:transparent;cursor:pointer;padding:0;border-radius:50%;">
          <div class="user-avatar" id="user-avatar" style="width:34px;height:34px;border-radius:50%;background:#eef0f3;color:#5b616e;display:grid;place-items:center;font-size:0.85rem;font-weight:700;overflow:hidden;border:2px solid #dee1e6;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:18px;height:18px;">
              <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
            </svg>
          </div>
        </button>
        <div class="user-dropdown" id="user-dropdown" role="menu" aria-hidden="true" style="position:absolute;top:calc(100% + 8px);right:0;min-width:230px;border:1px solid #dee1e6;border-radius:8px;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,0.10);overflow:hidden;z-index:30;display:none;">
          <a href="/perfil" role="menuitem" style="display:flex;align-items:center;gap:10px;width:100%;padding:11px 16px;font-size:0.88rem;font-weight:500;color:#0a0b0d;text-decoration:none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Mi perfil
          </a>
          <a id="admin-link" href="/admin" role="menuitem" hidden style="display:flex;align-items:center;gap:10px;width:100%;padding:11px 16px;font-size:0.88rem;font-weight:500;color:#0a0b0d;text-decoration:none;border-top:1px solid #dee1e6;">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.4 8.7-8 9-4.6-.3-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
            Administracion
          </a>
          <button id="header-logout" type="button" role="menuitem" style="display:flex;align-items:center;gap:10px;width:100%;padding:11px 16px;font-size:0.88rem;font-weight:500;color:#e53935;background:transparent;border:none;border-top:1px solid #dee1e6;cursor:pointer;text-align:left;">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Cerrar sesion
          </button>
        </div>
      </div>

      <!-- Cart icon -->
      {siteConfig.features.shop && (
        <button class="cart-trigger" id="cart-trigger" type="button" aria-label="Abrir carrito">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="cart-badge" id="cart-badge" aria-hidden="true">0</span>
        </button>
      )}
    </div>
  </div>
</header>

{siteConfig.features.shop && (
  <>
    <div class="cart-backdrop" id="cart-backdrop"></div>
    <aside class="cart-canvas" id="cart-canvas" aria-label="Carrito" aria-hidden="true">
      <div class="canvas-header">
        <h2>Carrito</h2>
        <button class="canvas-close" id="canvas-close" type="button" aria-label="Cerrar carrito">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="canvas-body">
        <div class="canvas-loading" id="canvas-loading" hidden aria-hidden="true">
          <article><span></span><div><span></span><span></span></div><span></span></article>
          <article><span></span><div><span></span><span></span></div><span></span></article>
        </div>
        <ul class="canvas-items" id="canvas-items" aria-live="polite"></ul>
        <div class="canvas-empty" id="canvas-empty">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <p>Tu carrito esta vacio</p>
          <a class="button button-secondary" href="/tienda">Ir a tienda</a>
        </div>
      </div>
      <div class="canvas-footer" id="canvas-footer">
        <div class="canvas-total">
          <span>Subtotal</span>
          <strong id="canvas-subtotal">0,00 €</strong>
        </div>
        <p class="canvas-warning" id="canvas-warning" hidden>Revisa las cantidades antes de continuar.</p>
        <a class="button button-primary canvas-cta" href="/carrito">Ver carrito completo</a>
      </div>
    </aside>
  </>
)}

<script is:inline define:vars={{ meUrl: tcgApi.me, logoutUrl: tcgApi.logout, wishlistUrl: tcgApi.wishlist, cartUrl: tcgApi.cart, shopEnabled: siteConfig.features.shop }}>
  const navActions = document.querySelector('.nav-actions');
  const guestItems = document.querySelectorAll('.session-guest');
  const userMenu = document.querySelector('#user-menu');
  const userAvatar = document.querySelector('#user-avatar');
  const adminLink = document.querySelector('#admin-link');
  const userTrigger = document.querySelector('#user-trigger');
  const userDropdown = document.querySelector('#user-dropdown');
  const logoutButton = document.querySelector('#header-logout');
  const authKey = 'tcg.authenticated';
  const userSummaryKey = 'tcg.user.summary';
  const sessionStorageKeys = [
    authKey,
    userSummaryKey,
    'tcg.cart.items',
    'tcg.cart.pending-merge',
    'tcg.wishlist.items',
    'tcg.last-order',
  ];

  const getInitials = (user) => {
    return ([user?.first_name, user?.last_name].filter(Boolean).join(' ') || user?.email || 'U').slice(0, 1).toUpperCase();
  };

  const renderAvatar = (summary) => {
    if (!userAvatar || !summary) return;

    if (summary.avatar_url) {
      userAvatar.innerHTML = '<img src="' + summary.avatar_url + '" alt="Avatar">';
      return;
    }

    userAvatar.textContent = summary.initials || 'U';
  };

  const readCachedSummary = () => {
    try { return JSON.parse(localStorage.getItem(userSummaryKey) || 'null'); } catch { return null; }
  };

  const csrfHeaders = () => {
    const csrf = document.cookie.split('; ').find((row) => row.startsWith('tcg_platform_csrf='))?.split('=')[1];
    if (!csrf) return {};
    return { 'X-TCG-CSRF': decodeURIComponent(csrf).split(':')[0] };
  };

  const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;',
  }[char]));

  const clearLocalSessionData = () => {
    try {
      sessionStorageKeys.forEach((key) => localStorage.removeItem(key));
    } catch {}
    try {
      Object.keys(sessionStorage)
        .filter((key) => key.startsWith('tcg.fetch:'))
        .forEach((key) => sessionStorage.removeItem(key));
    } catch {}

    window.dispatchEvent(new CustomEvent('tcg:cart-updated'));
    window.dispatchEvent(new CustomEvent('tcg:wishlist-updated'));
  };

  const setLoggedIn = (isLoggedIn, user) => {
    navActions?.setAttribute('data-auth-state', isLoggedIn ? 'user' : 'guest');
    guestItems.forEach((el) => { el.hidden = isLoggedIn; });
    if (userMenu) userMenu.hidden = !isLoggedIn;

    if (isLoggedIn) {
      const summary = user
        ? { avatar_url: user.avatar_url || '', initials: getInitials(user), can_access_backoffice: Boolean(user.can_access_backoffice) }
        : readCachedSummary();

      renderAvatar(summary);
      if (adminLink) adminLink.hidden = !summary?.can_access_backoffice;
    } else if (adminLink) {
      adminLink.hidden = true;
    }

    try {
      if (isLoggedIn) {
        localStorage.setItem(authKey, '1');

        if (user) {
          localStorage.setItem(userSummaryKey, JSON.stringify({
            avatar_url: user.avatar_url || '',
            initials: getInitials(user),
            can_access_backoffice: Boolean(user.can_access_backoffice),
          }));
        }
      } else {
        localStorage.removeItem(authKey);
        localStorage.removeItem(userSummaryKey);
      }
    } catch {}
  };

  // Optimistic hint from previous session
  try {
    if (localStorage.getItem(authKey) === '1') setLoggedIn(true, null);
  } catch {}

  // Real auth check
  fetch(meUrl, { credentials: 'include' })
    .then((r) => {
      if (r.ok) return r.json().then((d) => setLoggedIn(true, d.data));
      else setLoggedIn(false, null);
    })
    .catch(() => setLoggedIn(false, null));

  // Dropdown toggle
  const openDropdown = () => {
    if (userDropdown) userDropdown.style.display = 'block';
    userTrigger?.setAttribute('aria-expanded', 'true');
  };
  const closeDropdown = () => {
    if (userDropdown) userDropdown.style.display = 'none';
    userTrigger?.setAttribute('aria-expanded', 'false');
  };

  userTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    userDropdown?.style.display === 'block' ? closeDropdown() : openDropdown();
  });

  document.addEventListener('click', closeDropdown);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDropdown(); });

  logoutButton?.addEventListener('click', async () => {
    try { await fetch(logoutUrl, { method: 'POST', credentials: 'include', headers: csrfHeaders() }); } catch {}
    clearLocalSessionData();
    setLoggedIn(false, null);
    window.location.assign('/login');
  });

  if (!shopEnabled) return;

  // --- Cart ---
  const cartKey = 'tcg.cart.items';
  const wishlistIdsKey = 'tcg.wishlist.ids';
  const cacheTtl = 300000;
  const loginCartUrl = '/login?next=%2Fcarrito';
  let canvasCartItems = null;
  const readLocalCart = () => {
    try { return JSON.parse(localStorage.getItem(cartKey) || '[]'); } catch { return []; }
  };
  const writeLocalCart = (items) => {
    try { localStorage.setItem(cartKey, JSON.stringify(items)); } catch {}
  };
  const readCachedWishlistIds = () => {
    try {
      const cached = JSON.parse(localStorage.getItem(wishlistIdsKey) || 'null');
      if (!cached || Date.now() - Number(cached.time || 0) > cacheTtl) return null;
      return new Set((cached.data || []).map((id) => Number(id)));
    } catch {
      return null;
    }
  };
  const writeCachedWishlistIds = (ids) => {
    try {
      localStorage.setItem(wishlistIdsKey, JSON.stringify({ time: Date.now(), data: Array.from(ids || []) }));
    } catch {}
  };
  const formatMoney = (value) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(value);
  const itemSubtotal = (item) => {
    const raw = Number(item.line_subtotal_raw);
    if (Number.isFinite(raw)) return raw;
    const price = Number(item.price_raw);
    return Number.isFinite(price) ? price * Number(item.quantity || 1) : 0;
  };
  const getMaxQuantity = (item) => {
    const max = Number(item.max_quantity);
    return Number.isFinite(max) && max > 0 ? max : 99;
  };
  const getItemNotice = (item) => {
    if (item.notice) return item.notice;
    if (item.is_in_stock === false) return 'Sin stock';
    const max = Number(item.max_quantity);
    if (Number.isFinite(max) && max > 0 && Number(item.quantity || 1) > max) return `Solo quedan ${max}`;
    return '';
  };
  const readCart = async () => {
    try {
      if (localStorage.getItem(authKey) === '1') {
        const response = await fetch(cartUrl, { credentials: 'include' });
        if (!response.ok) throw new Error('Cart API failed');
        const payload = await response.json();
        canvasCartItems = payload.data || [];
        writeLocalCart(canvasCartItems);
        return canvasCartItems;
      }
    } catch {}

    canvasCartItems = readLocalCart();
    return canvasCartItems;
  };

  let canvasWishlistIds = null;
  const ensureCanvasWishlist = async (forceRefresh = false) => {
    if (canvasWishlistIds instanceof Set) return canvasWishlistIds;
    if (!forceRefresh) {
      const cached = readCachedWishlistIds();
      if (cached instanceof Set) {
        canvasWishlistIds = cached;
        fetchWishlistIds(true).catch(() => {});
        return canvasWishlistIds;
      }
    }

    return fetchWishlistIds(forceRefresh);
  };

  const fetchWishlistIds = async () => {
    try {
      const response = await fetch(`${wishlistUrl}?ids_only=1`, { credentials: 'include' });
      if (!response.ok) throw new Error('Guest');
      const payload = await response.json();
      canvasWishlistIds = new Set((payload.data || []).map((id) => Number(id)));
      writeCachedWishlistIds(canvasWishlistIds);
    } catch {
      canvasWishlistIds = null;
    }

    return canvasWishlistIds;
  };

  const saveCanvasWishlist = async (button) => {
    const productId = Number(button.dataset.id);

    try {
      if (localStorage.getItem(authKey) !== '1') {
        window.location.assign(loginCartUrl);
        return;
      }
    } catch {
      window.location.assign(loginCartUrl);
      return;
    }

    button.disabled = true;

    try {
      const wishlistIds = await ensureCanvasWishlist();
      const wasSaved = wishlistIds instanceof Set && wishlistIds.has(productId);
      const response = await fetch(wasSaved ? `${wishlistUrl}/${productId}` : wishlistUrl, {
        method: wasSaved ? 'DELETE' : 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', ...csrfHeaders() },
        body: wasSaved ? undefined : JSON.stringify({ product_id: productId }),
      });

      if (response.status === 401 || response.status === 403) {
        window.location.assign(loginCartUrl);
        return;
      }

      if (!response.ok) throw new Error('Wishlist failed');

      if (!(canvasWishlistIds instanceof Set)) canvasWishlistIds = new Set();

      if (wasSaved) {
        canvasWishlistIds.delete(productId);
        writeCachedWishlistIds(canvasWishlistIds);
        button.setAttribute('aria-pressed', 'false');
        button.classList.remove('is-active');
        button.setAttribute('aria-label', 'Guardar en wishlist');
        window.dispatchEvent(new CustomEvent('tcg:wishlist-updated', {
          detail: { productId, action: 'removed' },
        }));
      } else {
        canvasWishlistIds.add(productId);
        writeCachedWishlistIds(canvasWishlistIds);
        button.setAttribute('aria-pressed', 'true');
        button.classList.add('is-active');
        button.setAttribute('aria-label', 'Guardado en wishlist');
        window.dispatchEvent(new CustomEvent('tcg:wishlist-updated', {
          detail: { productId, action: 'added' },
        }));
      }
    } catch {
      button.setAttribute('aria-label', 'No se pudo actualizar la wishlist');
      button.classList.add('is-error');
      window.setTimeout(() => button.classList.remove('is-error'), 1400);
    } finally {
      button.disabled = false;
    }
  };

  const badge = document.querySelector('#cart-badge');
  const canvas = document.querySelector('#cart-canvas');
  const backdrop = document.querySelector('#cart-backdrop');
  const canvasItems = document.querySelector('#canvas-items');
  const canvasEmpty = document.querySelector('#canvas-empty');
  const canvasFooter = document.querySelector('#canvas-footer');
  const canvasLoading = document.querySelector('#canvas-loading');
  const canvasSubtotal = document.querySelector('#canvas-subtotal');
  const canvasWarning = document.querySelector('#canvas-warning');
  let canvasRenderId = 0;

  // Synchronous badge update — reads from in-memory cache or localStorage immediately.
  const updateBadge = (items) => {
    if (!badge) return;
    const data = items ?? canvasCartItems ?? readLocalCart();
    const total = data.reduce((s, i) => s + (i.quantity || 1), 0);
    badge.textContent = String(total > 99 ? '99+' : total);
    badge.classList.toggle('visible', total > 0);
  };

  const setCanvasLoading = (isLoading) => {
    if (canvasLoading) canvasLoading.hidden = !isLoading;
    if (canvasItems) canvasItems.hidden = isLoading;
    if (canvasEmpty) canvasEmpty.style.display = isLoading ? 'none' : 'none';
    if (canvasFooter) canvasFooter.style.display = isLoading ? 'none' : 'none';
  };

  const renderCanvas = async (forceRefresh) => {
    const renderId = ++canvasRenderId;

    // Use cached items for instant render; only show skeleton on first open.
    const cached = !forceRefresh && canvasCartItems;
    if (!cached) setCanvasLoading(true);
    const [items, wishlistIds] = await Promise.all([
      cached ? Promise.resolve(cached) : readCart(),
      ensureCanvasWishlist(),
    ]);

    if (renderId !== canvasRenderId) return;

    const hasItems = items.length > 0;
    setCanvasLoading(false);

    if (!cached) {
      // background revalidation after first render
    } else {
      readCart().then((fresh) => {
        if (renderId !== canvasRenderId) return;
        if (JSON.stringify(fresh) !== JSON.stringify(cached)) renderCanvas(true);
      }).catch(() => {});
    }

    setCanvasLoading(false);
    if (canvasEmpty) canvasEmpty.style.display = hasItems ? 'none' : 'flex';
    if (canvasFooter) canvasFooter.style.display = hasItems ? 'flex' : 'none';
    if (canvasSubtotal) canvasSubtotal.textContent = formatMoney(items.reduce((sum, item) => sum + itemSubtotal(item), 0));
    if (canvasWarning) {
      const hasIssues = items.some((item) => item.is_valid === false || item.is_in_stock === false || Boolean(getItemNotice(item)));
      canvasWarning.hidden = !hasIssues;
    }
    if (!canvasItems) return;
    canvasItems.hidden = false;

    canvasItems.innerHTML = items.map((item) => {
      const id = Number(item.id);
      const name = escapeHtml(item.name || 'Producto');
      const price = escapeHtml(item.price || '-');
      const image = escapeHtml(item.image);
      const quantity = Number(item.quantity || 1);
      const maxQuantity = getMaxQuantity(item);
      const lineSubtotal = escapeHtml(item.line_subtotal || formatMoney(itemSubtotal(item)));
      const notice = getItemNotice(item);
      const isInvalid = item.is_valid === false || item.is_in_stock === false || quantity > maxQuantity;
      const saved = wishlistIds instanceof Set && wishlistIds.has(id);

      return `
        <li class="canvas-item ${isInvalid ? 'has-issue' : ''}">
          <div class="canvas-item-media">
            ${item.image ? '<img src="' + image + '" alt="" loading="lazy">' : '<span aria-hidden="true">' + name.slice(0, 1).toUpperCase() + '</span>'}
          </div>
          <div class="canvas-item-info">
            <strong>${name}</strong>
            <p>${price} · ${lineSubtotal}</p>
            ${notice ? `<small class="canvas-item-notice">${escapeHtml(notice)}</small>` : ''}
            <div class="canvas-quantity" aria-label="Cantidad de ${name}">
              <button class="canvas-qty-step" type="button" data-action="decrease" data-id="${id}" aria-label="Restar una unidad">-</button>
              <input class="canvas-qty-input" type="number" min="1" max="${maxQuantity}" value="${quantity}" data-id="${id}" aria-label="Cantidad">
              <button class="canvas-qty-step" type="button" data-action="increase" data-id="${id}" ${quantity >= maxQuantity ? 'disabled' : ''} aria-label="Sumar una unidad">+</button>
            </div>
          </div>
          <div class="canvas-item-actions">
            <button class="canvas-wishlist ${saved ? 'is-active' : ''}" type="button" data-id="${id}" aria-pressed="${saved ? 'true' : 'false'}" aria-label="Guardar ${name} en wishlist">
              <svg class="heart-empty" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6Z"/></svg>
              <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.2 4.1 13.4A5.55 5.55 0 0 1 12 5.6a5.55 5.55 0 0 1 7.9 7.8L12 21.2Z"/></svg>
            </button>
            <button class="canvas-remove" type="button" data-id="${id}" aria-label="Quitar ${name}">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </li>
      `;
    }).join('');

    canvasItems.querySelectorAll('.canvas-wishlist').forEach((btn) => {
      btn.addEventListener('click', () => saveCanvasWishlist(btn));
    });

    const updateCanvasQuantity = async (productId, quantity, control) => {
      const item = canvasCartItems?.find((current) => Number(current.id) === productId);
      const nextQuantity = Math.max(0, Math.min(item ? getMaxQuantity(item) : 99, Number(quantity) || 0));

      if (control) control.disabled = true;

      try {
        if (localStorage.getItem(authKey) === '1') {
          const response = await fetch(`${cartUrl}/${productId}`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', ...csrfHeaders() },
            body: JSON.stringify({ quantity: nextQuantity }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload.message || 'Cart API failed');
          canvasCartItems = payload.data || [];
        } else {
          canvasCartItems = readLocalCart()
            .map((i) => Number(i.id) === productId ? { ...i, quantity: nextQuantity } : i)
            .filter((i) => Number(i.quantity) > 0);
        }
        writeLocalCart(canvasCartItems);
        window.dispatchEvent(new CustomEvent('tcg:cart-updated', { detail: { items: canvasCartItems } }));
      } catch {
        if (control) control.classList.add('is-error');
        window.setTimeout(() => control?.classList.remove('is-error'), 1200);
      } finally {
        renderCanvas(false);
        updateBadge();
      }
    };

    canvasItems.querySelectorAll('.canvas-qty-step').forEach((btn) => {
      btn.addEventListener('click', () => {
        const productId = Number(btn.dataset.id);
        const item = canvasCartItems?.find((current) => Number(current.id) === productId);
        const quantity = Number(item?.quantity || 1);
        const delta = btn.dataset.action === 'increase' ? 1 : -1;
        updateCanvasQuantity(productId, quantity + delta, btn);
      });
    });

    canvasItems.querySelectorAll('.canvas-qty-input').forEach((input) => {
      input.addEventListener('change', () => {
        updateCanvasQuantity(Number(input.dataset.id), Number(input.value), input);
      });
    });

    canvasItems.querySelectorAll('.canvas-remove').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const productId = Number(btn.dataset.id);
        try {
          if (localStorage.getItem(authKey) === '1') {
            const response = await fetch(`${cartUrl}/${productId}`, {
              method: 'DELETE',
              credentials: 'include',
              headers: csrfHeaders(),
            });
            if (!response.ok) throw new Error('Cart API failed');
            const payload = await response.json();
            canvasCartItems = payload.data || [];
          } else {
            canvasCartItems = readLocalCart().filter((i) => Number(i.id) !== productId);
          }
        } catch {
          canvasCartItems = readLocalCart().filter((i) => Number(i.id) !== productId);
        }
        writeLocalCart(canvasCartItems);
        window.dispatchEvent(new CustomEvent('tcg:cart-updated', { detail: { items: canvasCartItems } }));
        renderCanvas(false);
        updateBadge();
      });
    });
  };

  const openCanvas = () => {
    canvas?.setAttribute('aria-hidden', 'false');
    canvas?.classList.add('open');
    backdrop?.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (!canvasCartItems) setCanvasLoading(true);
    renderCanvas(false);
  };

  const closeCanvas = () => {
    canvas?.setAttribute('aria-hidden', 'true');
    canvas?.classList.remove('open');
    backdrop?.classList.remove('open');
    document.body.style.overflow = '';
  };

  document.querySelector('#cart-trigger')?.addEventListener('click', openCanvas);
  document.querySelector('#canvas-close')?.addEventListener('click', closeCanvas);
  backdrop?.addEventListener('click', closeCanvas);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCanvas(); });
  window.addEventListener('tcg:cart-updated', (event) => {
    if (Array.isArray(event.detail?.items)) {
      canvasCartItems = event.detail.items;
      writeLocalCart(canvasCartItems);
      updateBadge(canvasCartItems);
    } else {
      canvasCartItems = null;
      updateBadge(null);
    }
    if (canvas?.classList.contains('open')) renderCanvas(false);
  });
  window.addEventListener('tcg:wishlist-updated', (event) => {
    const detail = event.detail || {};
    const productId = Number(detail.productId);

    if (productId && detail.action) {
      if (!(canvasWishlistIds instanceof Set)) canvasWishlistIds = new Set();
      if (detail.action === 'added') canvasWishlistIds.add(productId);
      if (detail.action === 'removed') canvasWishlistIds.delete(productId);
      writeCachedWishlistIds(canvasWishlistIds);
    } else {
      canvasWishlistIds = null;
    }

    if (canvas?.classList.contains('open')) renderCanvas(false);
  });

  // Show badge immediately from localStorage (synchronous, no network)
  updateBadge(null);

  // Background cart refresh so badge and canvas stay fresh
  if (localStorage.getItem(authKey) === '1') {
    readCart().then((items) => {
      canvasCartItems = items;
      updateBadge(items);
    }).catch(() => {});
    ensureCanvasWishlist().catch(() => {});
  }
</script>

